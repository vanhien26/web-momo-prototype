---
interface Props {
  backLabel?: string;
  backHref?: string;
  logoSrc?: string;
  logoAlt?: string;
  logoText?: string;
  logoTextEm?: string;
}

const {
  backLabel = 'Giao Thông',
  backHref = '/tien-ich-giao-thong',
  logoSrc = 'https://homepage.momocdn.net/img/dang-kiem-260710113006.png',
  logoAlt = 'Tiện ích Giao thông',
  logoText = 'Tiện Ích',
  logoTextEm = 'Giao Thông',
} = Astro.props;
---

<div class="gas-strip">
  <div class="gas-strip-inner">
    <span class="gs-label"><span class="gs-dot"></span>Giá xăng <span id="gs-date"></span></span>
    <span class="gs-item"><span class="gs-name">RON 95-III</span><span class="gs-price">22.850đ</span><span class="gs-change down">▲1.420</span></span>
    <span class="gs-item"><span class="gs-name">E5 RON 92</span><span class="gs-price">22.380đ</span><span class="gs-change down">▲1.300</span></span>
    <a class="gs-link" href="/tien-ich-giao-thong/gia-xang">Xem chi tiết →</a>
  </div>
</div>

<nav class="site-nav">
  <div class="nav-inner">
    <div class="nav-left">
      <a class="nav-back" href={backHref}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>{backLabel}</span>
      </a>
      <div class="nav-sep"></div>
      <a class="nav-logo" href={backHref}>
        <span class="logo-icon"><img src={logoSrc} alt={logoAlt}></span>
        <span class="logo-text">{logoText} <em>{logoTextEm}</em></span>
      </a>
    </div>

    <div class="nav-links">

      <!-- Di chuyển -->
      <div class="nav-item">
        <button class="nav-trigger">
          Di chuyển
          <svg class="nav-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="nav-dropdown"><div class="nav-dropdown-inner">
          <div class="nav-mega">
            <div class="mega-col">
              <div class="mega-col-label">Nhiên liệu</div>
              <a class="mega-item" href="/tien-ich-giao-thong/gia-xang">
                <span class="mega-icon" style="background:#fef3c7;color:#d97706">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 22V8l9-6 9 6v14H3z"/><path d="M9 22v-6h6v6"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Giá xăng dầu hôm nay</div>
                  <div class="mega-item-desc">Cập nhật kỳ điều chỉnh mới nhất</div>
                </div>
              </a>
              <a class="mega-item" href="/cay-xang">
                <span class="mega-icon" style="background:#fef3c7;color:#d97706">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.3 5H17m0 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0zm-8 2a2 2 0 1 0 4 0 2 2 0 0 0-4 0z"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Tìm cây xăng gần đây</div>
                  <div class="mega-item-desc">Bản đồ trạm xăng theo vị trí</div>
                </div>
              </a>
              <a class="mega-item" href="/tram-sac">
                <span class="mega-icon" style="background:#dcfce7;color:#16a34a">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3.19M15 6h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-3.19"/><line x1="23" y1="13" x2="23" y2="11"/><polyline points="11 6 7 12 13 12 9 18"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Trạm sạc xe điện</div>
                  <div class="mega-item-desc">Tìm trạm EV gần nhất</div>
                </div>
              </a>
            </div>
            <div class="mega-col">
              <div class="mega-col-label">Hành trình</div>
              <a class="mega-item" href="/tien-ich-giao-thong/chuyen-di">
                <span class="mega-icon" style="background:#ede9fe;color:#7c3aed">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Tính chi phí chuyến đi</div>
                  <div class="mega-item-desc">Xăng, phí cầu đường, thời gian</div>
                </div>
              </a>
              <a class="mega-item" href="/epass/tinh-phi-etc">
                <span class="mega-icon" style="background:#ede9fe;color:#7c3aed">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Tính phí ETC theo tuyến</div>
                  <div class="mega-item-desc">Phí trạm thu phí không dừng</div>
                </div>
              </a>
            </div>
          </div>
          </div>
        </div>
      </div>

      <!-- Bảo hiểm -->
      <div class="nav-item">
        <button class="nav-trigger">
          Bảo hiểm
          <svg class="nav-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="nav-dropdown"><div class="nav-dropdown-inner">
          <div class="nav-list">
            <a class="nav-list-item" href="/bao-hiem-o-to">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
              Bảo hiểm TNDS bắt buộc
            </a>
            <a class="nav-list-item" href="/bao-hiem-o-to">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Bảo hiểm thân vỏ ô tô
            </a>
            <div class="nav-list-sep"></div>
            <a class="nav-list-item" href="/bao-hiem-xe-may">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6h-5L7 17h14l-2-7h-4l-2-4z"/></svg>
              Bảo hiểm xe máy
            </a>
          </div>
          </div>
        </div>
      </div>

      <!-- Pháp lý & Bảo dưỡng -->
      <div class="nav-item">
        <button class="nav-trigger">
          Pháp lý &amp; Bảo dưỡng
          <svg class="nav-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="nav-dropdown"><div class="nav-dropdown-inner">
          <div class="nav-mega">
            <div class="mega-col">
              <div class="mega-col-label">Pháp lý</div>
              <a class="mega-item" href="/phat-nguoi">
                <span class="mega-icon" style="background:#fee2e2;color:#dc2626">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Tra phạt nguội</div>
                  <div class="mega-item-desc">Kiểm tra vi phạm giao thông</div>
                </div>
              </a>
              <a class="mega-item" href="/tien-ich-giao-thong/dang-kiem">
                <span class="mega-icon" style="background:#dbeafe;color:#2563eb">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Kiểm tra đăng kiểm</div>
                  <div class="mega-item-desc">Hạn đăng kiểm phương tiện</div>
                </div>
              </a>
            </div>
            <div class="mega-col">
              <div class="mega-col-label">Bảo dưỡng</div>
              <a class="mega-item" href="/tien-ich-giao-thong/bao-duong">
                <span class="mega-icon" style="background:#fef9c3;color:#ca8a04">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Lịch bảo dưỡng xe</div>
                  <div class="mega-item-desc">Nhắc nhở theo km & thời gian</div>
                </div>
              </a>
              <a class="mega-item" href="/tien-ich-giao-thong/cuu-ho">
                <span class="mega-icon" style="background:#fee2e2;color:#dc2626">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l1.17-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Cứu hộ khẩn cấp</div>
                  <div class="mega-item-desc">Gọi cứu hộ khi gặp sự cố</div>
                </div>
              </a>
            </div>
          </div>
          </div>
        </div>
      </div>

      <!-- Xe của tôi -->
      <div class="nav-item">
        <button class="nav-trigger">
          Xe của tôi
          <svg class="nav-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="nav-dropdown"><div class="nav-dropdown-inner">
          <div class="nav-mega">
            <div class="mega-col">
              <div class="mega-col-label">Hồ sơ &amp; Chi phí</div>
              <a class="mega-item" href="/tien-ich-giao-thong#ho-so-xe">
                <span class="mega-icon" style="background:#f0fdf4;color:#16a34a">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Hồ sơ phương tiện</div>
                  <div class="mega-item-desc">Biển số, đăng ký, bảo hiểm</div>
                </div>
              </a>
              <a class="mega-item" href="/tien-ich-giao-thong#chi-phi-xe">
                <span class="mega-icon" style="background:#fdf4ff;color:#9333ea">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Chi phí nuôi xe / năm</div>
                  <div class="mega-item-desc">Xăng, bảo dưỡng, bảo hiểm</div>
                </div>
              </a>
              <a class="mega-item" href="/tien-ich-giao-thong/hang-xe">
                <span class="mega-icon" style="background:#f0f9ff;color:#0284c7">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Nhãn xe &amp; Dòng xe</div>
                  <div class="mega-item-desc">Thông số kỹ thuật, so sánh</div>
                </div>
              </a>
            </div>
            <div class="mega-col">
              <div class="mega-col-label">Tiện ích</div>
              <a class="mega-item" href="/epass">
                <span class="mega-icon" style="background:#ffe4e6;color:#e11d48">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">ePass &amp; Tự động nạp</div>
                  <div class="mega-item-desc">Quản lý tài khoản ETC</div>
                </div>
              </a>
              <a class="mega-item" href="/tien-ich-giao-thong/bai-do-xe">
                <span class="mega-icon" style="background:#fef3c7;color:#d97706">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="10" r="3"/><path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 6.9 8 11.7z"/></svg>
                </span>
                <div>
                  <div class="mega-item-name">Tìm bãi đỗ xe</div>
                  <div class="mega-item-desc">Bãi xe gần đây, còn chỗ</div>
                </div>
              </a>
            </div>
          </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</nav>

<script>
(function(){
  const el = document.getElementById('gs-date');
  if (el) {
    const d = new Date();
    el.textContent = String(d.getDate()).padStart(2,'0') + '/' + String(d.getMonth()+1).padStart(2,'0');
  }
})();
</script>
