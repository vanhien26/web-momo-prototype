---
import VehicleHub from '../../layouts/VehicleHub.astro';
import '../../styles/proto-themes.css';

const rawCss = `
html, body { overflow: auto !important; height: auto !important; }
body { display: block !important; }
#navSearch, .nav-search { display: none !important; }
.nav-search-icon-btn, .nav-menu-btn { display: none !important; }
.site-nav { background: rgba(255,255,255,.97) !important; transition: none !important; }
.site-nav:has(.nav-item:hover) { background: rgba(255,255,255,.97) !important; border-bottom-color: rgba(0,0,0,.06) !important; box-shadow: 0 1px 3px rgba(0,0,0,.04) !important; }

:root {
  --pink-50:#FFF0F7; --pink-100:#FFD6EC; --pink-300:#F472B6; --pink-400:#EC4899;
  --pink-500:#EB2F96; --pink-600:#DB2777;
  --green-500:#22C55E; --blue-600:#2563EB; --amber-500:#F59E0B;
  --gray-50:#F9FAFB; --gray-100:#F3F4F6; --gray-200:#E5E7EB; --gray-300:#D1D5DB;
  --gray-400:#9CA3AF; --gray-500:#6B7280; --gray-600:#4B5563;
  --gray-700:#374151; --gray-800:#1F2937; --gray-900:#111827;
  --content: 960px;
}

.tp-container { max-width: var(--content); margin: 0 auto; padding: 24px 20px 80px; }
.tp-hero { background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); color: #fff; border-radius: 20px; padding: 32px 28px; margin-bottom: 24px; }
.tp-hero h1 { font-size: 26px; font-weight: 900; margin-bottom: 8px; }
.tp-hero p { font-size: 14px; opacity: 0.8; max-width: 540px; line-height: 1.5; }

.tp-grid { display: grid; grid-template-columns: 1fr 340px; gap: 20px; }
@media(max-width:768px){ .tp-grid { grid-template-columns: 1fr; } }

.tp-card { background: #fff; border: 1px solid var(--gray-200); border-radius: 16px; padding: 20px; margin-bottom: 16px; }
.tp-card-title { font-size: 15px; font-weight: 800; color: var(--gray-900); margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }

.tp-field { margin-bottom: 14px; }
.tp-label { font-size: 12px; font-weight: 700; color: var(--gray-600); margin-bottom: 6px; display: block; }
.tp-input { width: 100%; padding: 10px 12px; border: 1.5px solid var(--gray-200); border-radius: 10px; font-size: 14px; font-weight: 600; outline: none; transition: border-color .15s; font-family: inherit; }
.tp-input:focus { border-color: var(--pink-500); }

.tp-btn { width: 100%; padding: 13px; background: var(--pink-500); color: #fff; border: none; border-radius: 12px; font-size: 15px; font-weight: 800; cursor: pointer; transition: background .15s; font-family: inherit; display: flex; align-items: center; justify-content: center; gap: 8px; }
.tp-btn:hover { background: var(--pink-600); }

.tp-res-box { background: var(--pink-50); border: 1.5px solid var(--pink-100); border-radius: 16px; padding: 20px; margin-top: 16px; text-align: center; }
.tp-res-val { font-size: 28px; font-weight: 900; color: var(--pink-500); margin: 6px 0; }
`;
---

<VehicleHub
  title="Tính Chi Phí Chuyến Đi & Phí Cầu Đường ETC | MoMo"
  description="Công cụ ước tính chi phí xăng dầu, phí trạm thu phí ETC và thời gian di chuyển chính xác cho mọi hành trình lái xe ô tô, xe máy."
  theme="momo"
>

<Fragment set:html={`<style>${rawCss}</style>`} />

<div class="tp-container">
  <div class="tp-hero">
    <h1>🚗 Tính chi phí chuyến đi chính xác</h1>
    <p>Ước tính nhiên liệu tiêu thụ, phí trạm thu phí không dừng ETC và tổng chi phí lộ trình lái xe tại Việt Nam.</p>
  </div>

  <div class="tp-grid">
    <div>
      <div class="tp-card">
        <div class="tp-card-title">📍 Lộ trình di chuyển</div>
        
        <div class="tp-field">
          <label class="tp-label">Điểm xuất phát</label>
          <input class="tp-input" id="tpStart" type="text" value="Hà Nội" placeholder="Nhập điểm đi..." />
        </div>

        <div class="tp-field">
          <label class="tp-label">Điểm đến</label>
          <input class="tp-input" id="tpEnd" type="text" value="Hải Phòng" placeholder="Nhập điểm đến..." />
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="tp-field">
            <label class="tp-label">Khoảng cách (km)</label>
            <input class="tp-input" id="tpDist" type="number" value="120" oninput="calcTrip()" />
          </div>
          <div class="tp-field">
            <label class="tp-label">Mức tiêu thụ (L/100km)</label>
            <input class="tp-input" id="tpRate" type="number" value="7.5" step="0.5" oninput="calcTrip()" />
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="tp-field">
            <label class="tp-label">Giá xăng (đ/Lít)</label>
            <input class="tp-input" id="tpPrice" type="number" value="21500" step="500" oninput="calcTrip()" />
          </div>
          <div class="tp-field">
            <label class="tp-label">Phí trạm ETC (đ)</label>
            <input class="tp-input" id="tpEtc" type="number" value="110000" step="5000" oninput="calcTrip()" />
          </div>
        </div>

        <button class="tp-btn" onclick="calcTrip()">⚡ Tính toán tổng chi phí</button>

        <div class="tp-res-box">
          <div style="font-size:12px;font-weight:700;color:var(--gray-600);text-transform:uppercase">Ước tính tổng chi phí chuyến đi</div>
          <div class="tp-res-val" id="tpTotal">303,500 đ</div>
          <div style="font-size:12px;color:var(--gray-500)" id="tpSub">Xăng: 193,500đ (9 Lít) + ETC: 110,000đ</div>
        </div>
      </div>
    </div>

    <div>
      <div class="tp-card">
        <div class="tp-card-title">💡 Mẹo tiết kiệm nhiên liệu</div>
        <ul style="font-size:13px;color:var(--gray-600);line-height:1.6;padding-left:18px">
          <li style="margin-bottom:8px">Duy trì tốc độ ổn định 60 - 80 km/h trên đường quốc lộ.</li>
          <li style="margin-bottom:8px">Kiểm tra áp suất lốp trước khi khởi hành xa.</li>
          <li style="margin-bottom:8px">Nạp trước tài khoản ePass/VETCn qua MoMo để qua trạm nhanh chóng.</li>
        </ul>
      </div>

      <div class="tp-card" style="background:linear-gradient(135deg,#065f46,#047857);color:#fff">
        <div style="font-size:14px;font-weight:800;margin-bottom:6px">Nạp ePass tự động</div>
        <div style="font-size:12px;opacity:0.85;margin-bottom:12px">Không lo thiếu tiền khi qua trạm thu phí không dừng.</div>
        <a href="/epass" style="display:inline-block;padding:8px 14px;background:#fff;color:#047857;font-size:12px;font-weight:800;border-radius:8px;text-decoration:none">Nạp ngay</a>
      </div>
    </div>
  </div>
</div>

</VehicleHub>

<script is:inline>
function calcTrip() {
  const dist = parseFloat(document.getElementById('tpDist')?.value || 0);
  const rate = parseFloat(document.getElementById('tpRate')?.value || 0);
  const price = parseFloat(document.getElementById('tpPrice')?.value || 0);
  const etc = parseFloat(document.getElementById('tpEtc')?.value || 0);

  const liters = (dist / 100) * rate;
  const gasCost = liters * price;
  const total = gasCost + etc;

  const tpTotal = document.getElementById('tpTotal');
  if (tpTotal) tpTotal.textContent = Math.round(total).toLocaleString('vi-VN') + ' đ';

  const tpSub = document.getElementById('tpSub');
  if (tpSub) tpSub.textContent = `Xăng: ${Math.round(gasCost).toLocaleString('vi-VN')}đ (${liters.toFixed(1)} Lít) + ETC: ${Math.round(etc).toLocaleString('vi-VN')}đ`;
}

document.addEventListener('DOMContentLoaded', calcTrip);
</script>
