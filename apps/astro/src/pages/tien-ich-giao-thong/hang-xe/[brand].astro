---
import HangXeApp from '../../../components/HangXeApp.astro';
import { BRANDS, BRAND_LIST } from '../../../data/hang-xe-data.js';

export function getStaticPaths() {
  return BRAND_LIST.filter(id => BRANDS[id]).map(id => ({ params: { brand: id } }));
}

const { brand } = Astro.params;
const b = BRANDS[brand];
const brandName = b?.name ?? brand;
---

<HangXeApp title={`${brandName} - Hãng Xe | Tiện Ích Giao Thông MoMo`} />
