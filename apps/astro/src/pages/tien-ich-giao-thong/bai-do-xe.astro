---
import VehicleHub from '../../layouts/VehicleHub.astro';
import '../../styles/proto-themes.css';
---

<VehicleHub
  title="Bãi đỗ xe ở Quận 1, TP. Hồ Chí Minh | MoMo Tiện Ích Giao Thông"
  description="Danh sách bãi đỗ xe ô tô, xe máy gần bạn: chỗ trống theo thời gian thực, phí gửi xe, giờ mở cửa và thanh toán không tiền mặt qua MoMo."
  theme="parking"
>

<style is:global>
  /* ── PAGE HEAD (filter sub-bar) */
  .page-head{background:rgba(255,255,255,.97);backdrop-filter:saturate(180%) blur(16px);-webkit-backdrop-filter:saturate(180%) blur(16px);border-bottom:1px solid var(--line);flex:none;z-index:29}
  .ph-brand{width:36px;height:36px;border-radius:10px;flex:none;overflow:hidden;background:var(--momo);display:grid;place-items:center;box-shadow:0 2px 8px rgba(216,45,139,.25)}
  .ph-brand img{width:22px;height:22px;object-fit:contain;display:block}
  .ph-text{flex:1;min-width:0}
  .ph-breadcrumb{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:700;color:var(--momo);text-transform:uppercase;letter-spacing:.06em;margin-bottom:2px}
  .ph-breadcrumb a:hover{text-decoration:underline}
  .ph-breadcrumb svg{flex:none;opacity:.7}
  .ph-title{font-size:15px;font-weight:900;line-height:1.2;color:var(--ink);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ph-sub{display:flex;align-items:center;gap:4px;font-size:10.5px;color:var(--muted);margin-top:1px}
  .ph-sub svg{flex:none;color:var(--momo)}
  .close-btn{display:grid;place-items:center;width:32px;height:32px;border-radius:999px;font-size:16px;color:var(--muted);border:1px solid var(--line);background:#fff;flex:none;transition:all .15s}
  .close-btn:hover{color:var(--ink);border-color:var(--grey-200);background:var(--page)}

  /* ── FILTER ROW */
  .filter-row{display:flex;align-items:center;gap:6px;padding:0 20px 10px;max-width:1440px;margin:0 auto;overflow-x:auto;scrollbar-width:none}
  .filter-row::-webkit-scrollbar{display:none}
  .filter-chip{display:inline-flex;align-items:center;gap:5px;padding:7px 13px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:11.5px;font-weight:600;color:var(--ink);white-space:nowrap;flex:none;transition:border-color .15s,background .15s,color .15s,box-shadow .15s}
  .filter-chip:hover{border-color:var(--momo);color:var(--momo)}
  .filter-chip.active{background:var(--momo);border-color:var(--momo);color:#fff;box-shadow:0 2px 10px rgba(216,45,139,.25)}
  .filter-chip .icon{font-size:13px}

  /* ── LAYOUT */
  .split{display:grid;grid-template-columns:400px 1fr;flex:1;overflow:hidden}

  /* ── LIST PANE */
  .list-pane{height:100%;overflow:hidden;position:relative;border-right:1px solid var(--line)}
  .list-scroll{height:100%;overflow-y:auto;overflow-x:hidden;padding:14px 20px 60px}
  .list-meta{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap;gap:8px}
  .list-title{font-size:16px;font-weight:800;margin:0;color:var(--ink)}
  .list-sub{font-size:11px;color:var(--muted);margin:3px 0 0}
  .sort-wrap{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--muted);font-weight:600;padding:6px 11px;border-radius:999px;background:#fff;border:1px solid var(--line);flex:none}
  .sort-wrap select{border:0;outline:0;background:transparent;font-size:11px;font-weight:700;color:var(--ink)}

  /* ── SPOT CARDS */
  .merchant-list{display:flex;flex-direction:column;gap:8px}
  .m-card{display:flex;align-items:flex-start;gap:12px;padding:12px;border-radius:12px;background:#fff;border:1px solid var(--line);cursor:pointer;transition:border-color .15s,box-shadow .15s}
  .m-card:hover{border-color:var(--grey-200);box-shadow:var(--shadow-sm)}
  .m-card.active{border-color:var(--momo);box-shadow:0 0 0 1.5px var(--momo)}
  .m-logo{width:52px;height:52px;border-radius:10px;flex:none;overflow:hidden;background:#fff;border:1px solid var(--line);display:grid;place-items:center;position:relative}
  .m-logo img{width:100%;height:100%;object-fit:contain;padding:6px;display:block}
  .m-logo-fallback{position:absolute;inset:0;display:grid;place-items:center;font-size:22px;color:#fff;background:linear-gradient(135deg,var(--bc,var(--momo)) 0%,var(--bc2,var(--momo-dark)) 100%)}
  .m-body{flex:1;min-width:0}
  .m-header{display:flex;align-items:baseline;gap:6px;margin-bottom:4px}
  .m-rating{font-size:11px;font-weight:700;color:#d97706;flex-shrink:0}
  .m-dist-wrap{margin-left:auto;font-size:10px;font-weight:700;color:var(--muted);white-space:nowrap;flex-shrink:0}
  .m-name{font-size:12.5px;font-weight:800;line-height:1.3;color:var(--ink);text-transform:uppercase;letter-spacing:.02em;flex:1;min-width:0}
  .m-meta{display:flex;align-items:center;gap:5px;margin-bottom:5px;flex-wrap:wrap}
  .badge-floor{font-size:9px;font-weight:800;color:#fff;background:var(--ink);padding:2px 7px;border-radius:4px;letter-spacing:.03em}
  .badge-cat{font-size:9px;font-weight:600;color:var(--muted);background:var(--page);border:1px solid var(--line);padding:2px 7px;border-radius:4px}
  .m-addr{font-size:10.5px;color:var(--muted);line-height:1.5;margin-bottom:6px}
  .m-badges{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
  .badge-fee{font-size:9px;font-weight:700;color:var(--muted);background:var(--page);border:1px solid var(--line);padding:2px 7px;border-radius:4px}

  /* ── MAP PANE */
  .map-pane{position:relative;height:100%;overflow:hidden}
  .map-pane #map{height:100%;width:100%;background:#e9eef3}
  .maplibregl-map{font-family:inherit}
  .maplibregl-ctrl-attrib{font-size:9px!important;background:rgba(255,255,255,.85)!important;padding:2px 7px!important;border-radius:6px 0 0 0!important}
  .maplibregl-popup-content{font-family:inherit;border-radius:8px;padding:5px 10px;font-size:10.5px;font-weight:700;box-shadow:0 2px 10px rgba(0,0,0,.12)}
  .maplibregl-popup-tip{display:none}
  .gl-pill{background:#fff;border:1.5px solid var(--pc,#16803d);border-radius:999px;padding:4px 9px;color:var(--pc,#16803d);font-size:11px;font-weight:800;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,.14),0 0 0 1.5px #fff;font-family:"MoMo Trust Sans",-apple-system,sans-serif;cursor:pointer;transition:transform .15s,box-shadow .15s,background .15s,color .15s,border-color .15s}
  .gl-pill.hover{transform:scale(1.08);box-shadow:0 4px 12px rgba(0,0,0,.2),0 0 0 1.5px #fff}
  .gl-pill.active{transform:scale(1.15);background:var(--momo);border-color:var(--momo-dark);color:#fff;box-shadow:0 4px 16px rgba(216,45,139,.45),0 0 0 2px #fff}
  .gl-user-dot{width:14px;height:14px;border-radius:50%;background:var(--momo);border:2.5px solid #fff;box-shadow:0 0 0 6px rgba(216,45,139,.2),0 2px 8px rgba(0,0,0,.3)}
  .map-overlay{position:absolute;top:14px;left:14px;z-index:400;background:rgba(255,255,255,.95);backdrop-filter:blur(10px);border-radius:999px;padding:8px 14px;font-size:11px;font-weight:700;color:var(--ink);box-shadow:0 2px 10px rgba(0,0,0,.08),0 0 0 1px rgba(0,0,0,.04);display:flex;align-items:center;gap:7px}
  .map-overlay i{width:7px;height:7px;border-radius:50%;background:var(--momo);display:inline-block;animation:pulse 1.6s infinite}
  @keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.6);opacity:.5}}
  .map-ctrl-stack{position:absolute;bottom:14px;right:14px;z-index:400;display:flex;flex-direction:column;gap:6px}
  .map-ctrl-group{background:rgba(255,255,255,.96);backdrop-filter:blur(10px);border-radius:10px;box-shadow:0 2px 10px rgba(0,0,0,.10),0 0 0 1px rgba(0,0,0,.04);display:flex;flex-direction:column;overflow:hidden}
  .map-ctrl-btn{width:38px;height:38px;border-radius:0;background:transparent;display:grid;place-items:center;color:var(--ink);font-size:18px;font-weight:700;box-shadow:none;transition:background .12s}
  .map-ctrl-btn:hover{background:rgba(0,0,0,.04)}
  .map-ctrl-divider{height:1px;background:rgba(0,0,0,.06);margin:0 4px}

  /* ── DETAIL MODAL */
  .detail-modal{position:absolute;inset:0;z-index:10;background:#fff;display:flex;flex-direction:column;overflow:hidden;transform:translateX(100%);transition:transform .28s cubic-bezier(.32,1,.22,1);pointer-events:none}
  body.has-detail .detail-modal{transform:translateX(0);pointer-events:auto}
  .detail-topbar{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border-bottom:1px solid var(--line);flex:none;background:#fff}
  .detail-back{display:inline-flex;align-items:center;gap:5px;height:30px;padding:0 12px 0 8px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:11px;font-weight:700;color:var(--ink);transition:all .15s}
  .detail-back:hover{border-color:var(--momo);color:var(--momo)}
  .detail-close{width:30px;height:30px;border-radius:999px;background:#fff;border:1px solid var(--line);display:grid;place-items:center;transition:all .15s}
  .detail-close:hover{border-color:var(--ink)}
  .detail-info-block{padding:14px 14px 12px;border-bottom:1px solid var(--line);flex:none;background:#fff}
  .detail-info-top{display:flex;align-items:flex-start;gap:12px;margin-bottom:10px}
  .detail-icon{width:56px;height:56px;border-radius:12px;flex:none;display:grid;place-items:center;font-size:26px;border:1px solid var(--line);overflow:hidden;background:#fff}
  .detail-icon img{width:100%;height:100%;object-fit:contain;padding:8px}
  .detail-info-main{flex:1;min-width:0}
  .detail-name{font-size:14px;font-weight:900;color:var(--ink);margin:0 0 4px;text-transform:uppercase;letter-spacing:.02em;line-height:1.2}
  .detail-status-inline{display:flex;align-items:center;gap:6px;margin-bottom:4px}
  .detail-row{display:flex;align-items:flex-start;gap:7px;margin-bottom:6px;font-size:11.5px;color:var(--muted)}
  .detail-row:last-child{margin-bottom:0}
  .detail-row svg{flex:none;margin-top:1px;color:var(--momo)}
  .detail-hours{color:var(--green);font-weight:600}
  .detail-hero{height:130px;position:relative;overflow:hidden;flex:none}
  .detail-hero-logo{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
  .detail-hero-logo img{width:64px;height:64px;object-fit:contain;filter:brightness(0) invert(1);opacity:.28}
  .detail-hero-logo span{font-size:40px;opacity:.3}
  .momo-overlay{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(0deg,rgba(0,0,0,.55) 0%,transparent 100%);padding:12px 12px 10px;display:flex;align-items:center;gap:8px}
  .momo-overlay-badge{display:inline-flex;align-items:center;gap:5px;background:var(--momo);color:#fff;border-radius:6px;padding:4px 9px;font-size:10px;font-weight:800;white-space:nowrap;flex:none}
  .momo-overlay-badge img{width:13px;height:13px;border-radius:3px;object-fit:contain;background:#fff}
  .momo-overlay-text{font-size:10px;color:rgba(255,255,255,.88);line-height:1.35}
  .momo-overlay-text strong{color:#fff;display:block;font-size:10.5px}
  .detail-scroll{flex:1;overflow-y:auto;padding:14px}
  .detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:12px}
  .detail-cell{background:var(--page);border-radius:8px;padding:9px 11px}
  .dc-lbl{font-size:9px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
  .dc-val{font-size:12.5px;font-weight:800;color:var(--ink);margin-top:2px;line-height:1.2}
  .dc-val.warn{color:var(--amber)} .dc-val.ok{color:var(--green)} .dc-val.bad{color:var(--red)}
  .pay-tags{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:10px}
  .pay-tag{font-size:10px;font-weight:700;padding:3px 9px;border-radius:999px}
  .pay-tag.momo{background:var(--pink-soft);color:var(--momo)}
  .pay-tag.vetc{background:#eff6ff;color:#1d4ed8}
  .pay-tag.eparking{background:#f0fdf4;color:#15803d}
  .pay-tag.iparking{background:#faf5ff;color:#7c3aed}
  .pay-tag.vinparking{background:#fff7ed;color:#c2410c}
  .pay-tag.cash{background:var(--page);color:var(--muted);border:1px solid var(--line)}
  .detail-desc{font-size:12px;color:var(--muted);line-height:1.6;margin:0 0 14px}
  .detail-actions{display:flex;flex-direction:column;gap:8px;padding-top:4px}
  .btn-primary{display:flex;align-items:center;justify-content:center;gap:6px;background:var(--momo);color:#fff;border-radius:10px;padding:13px;font-size:14px;font-weight:800;transition:background .15s,transform .15s}
  .btn-primary:hover{background:var(--momo-dark);transform:translateY(-1px)}
  .btn-secondary{display:flex;align-items:center;justify-content:center;gap:6px;background:#fff;color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:11px;font-size:13px;font-weight:700;transition:border-color .15s}
  .btn-secondary svg{color:var(--momo)}
  .btn-secondary:hover{border-color:var(--momo)}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(60px);background:var(--ink);color:#fff;border-radius:999px;padding:9px 20px;font-size:13px;font-weight:600;pointer-events:none;transition:transform .3s cubic-bezier(.34,1.56,.64,1),opacity .3s;opacity:0;z-index:9999;white-space:nowrap}
  .toast.show{transform:translateX(-50%) translateY(0);opacity:1}

  @media(max-width:700px){
    .split{grid-template-columns:1fr}
    .map-pane{display:none}
    .list-scroll{padding:12px 14px 60px}
    .filter-row{padding-left:14px;padding-right:14px}
  }
  .mega-item svg{flex-shrink:0;opacity:.7;transition:opacity .12s}
  .mega-item:hover svg{opacity:1}
</style>

<!-- FILTER SUB-BAR -->
<header class="page-head">
  <div class="filter-row" id="filterRow"></div>
</header>

<!-- SPLIT LAYOUT -->
<div class="split">

  <!-- LIST PANE -->
  <section class="list-pane">
    <div class="list-scroll">
      <div class="list-meta">
        <div>
          <h2 class="list-title" id="listTitle">8 bãi đỗ</h2>
          <p class="list-sub" id="listSub">Quận 1, TP.HCM · Tất cả</p>
        </div>
        <label class="sort-wrap">
          <select id="sortSelect" onchange="render()">
            <option value="dist">Gần nhất</option>
            <option value="price">Giá thấp nhất</option>
          </select>
        </label>
      </div>
      <div class="merchant-list" id="spotList"></div>
    </div>

    <aside class="detail-modal" id="detailModal">
      <div class="detail-topbar">
        <button class="detail-back" id="detailBack">
          <i data-lucide="chevron-left" width="14" height="14"></i>
          Danh sách
        </button>
        <button class="detail-close" id="detailClose">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="detail-info-block">
        <div class="detail-info-top">
          <div class="detail-icon" id="detailIcon"></div>
          <div class="detail-info-main">
            <h2 class="detail-name" id="detailName"></h2>
            <div class="detail-status-inline" id="detailStatus"></div>
          </div>
        </div>
        <div class="detail-row">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span id="detailAddr"></span>
        </div>
        <div class="detail-row">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span class="detail-hours" id="detailHours"></span>
        </div>
      </div>
      <div class="detail-hero" id="detailHero">
        <div class="detail-hero-logo" id="detailHeroLogo"></div>
        <div class="momo-overlay">
          <div class="momo-overlay-badge">
            <img src="https://homepage.momocdn.net/fileuploads/svg/momo-file-240411162904.svg" alt="MoMo">
            Thanh toán MoMo
          </div>
          <div class="momo-overlay-text" id="momoOverlayText">
            <strong>Không cần tiền mặt</strong>
            Vào ra tự động, phí trừ qua ví
          </div>
        </div>
      </div>
      <div class="detail-scroll">
        <div class="detail-grid" id="detailGrid"></div>
        <div class="pay-tags" id="detailPay"></div>
        <p class="detail-desc" id="detailDesc"></p>
        <div class="detail-actions">
          <button class="btn-primary" id="detailCTA">Dùng ngay qua MoMo</button>
          <button class="btn-secondary" onclick="toast('Đang mở Google Maps...')">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
            Chỉ đường
          </button>
        </div>
      </div>
    </aside>
  </section>

  <!-- MAP PANE -->
  <div class="map-pane">
    <div class="map-overlay"><i></i><span id="mapCount">8 bãi đỗ</span>&nbsp;quanh Quận 1</div>
    <div class="map-ctrl-stack">
      <div class="map-ctrl-group">
        <button class="map-ctrl-btn" id="ctrlZoomIn">
          <i data-lucide="plus" width="16" height="16"></i>
        </button>
        <div class="map-ctrl-divider"></div>
        <button class="map-ctrl-btn" id="ctrlZoomOut">
          <i data-lucide="minus" width="16" height="16"></i>
        </button>
      </div>
    </div>
    <div id="map"></div>
  </div>

</div>

<div class="toast" id="toast"></div>

<script is:inline>
const PARTNER_LOGOS = {
  vetc:'https://static.momocdn.net/app/img/transportcenter/ic_VETC_parking.png',
  eparking:'https://static.momocdn.net/app/img/publicservice/eparking_topup.png',
  iparking:'https://homepage.momocdn.net/img/dang-kiem-260710113006.png',
  vinparking:null,
};
const SPOTS = [
  {id:'p1',name:'Vincom Center Đồng Khởi',partner:'eparking',icon:'🅿️',color:'#d82d8b',color2:'#a50064',area:'Quận 1',addr:'72 Lê Thánh Tôn, Q.1, TP.HCM',dist:0.3,rating:4.5,vehicles:['xemay','oto'],fees:{xemay:{price:5000,unit:'lần'},oto:{price:20000,unit:'giờ'}},payment:['momo','vetc','eparking'],open:'06:00 - 23:00',overnight:false,note:'Tầng B1 và B2. Ra vào bằng thẻ VETC hoặc quét QR MoMo tại cổng. Camera nhận dạng biển số.',lat:10.7769,lng:106.7029},
  {id:'p2',name:'Bãi xe Trần Hưng Đạo',partner:'iparking',icon:'🛵',color:'#7c3aed',color2:'#6d28d9',area:'Quận 1',addr:'1 Trần Hưng Đạo, Q.1, TP.HCM',dist:0.6,rating:4.1,vehicles:['xemay'],fees:{xemay:{price:5000,unit:'lần'}},payment:['momo','iparking'],open:'05:00 - 23:00',overnight:false,note:'Bãi đỗ công cộng tích hợp iParking. Xe máy vào bằng vé giấy hoặc ứng dụng, thanh toán qua MoMo khi ra.',lat:10.7667,lng:106.6914},
  {id:'p3',name:'Công viên 23/9',partner:null,icon:'🌳',color:'#15803d',color2:'#166534',area:'Quận 1',addr:'Phạm Ngũ Lão, Q.1, TP.HCM',dist:0.9,rating:3.8,vehicles:['xemay','oto'],fees:{xemay:{price:5000,unit:'lần'},oto:{price:10000,unit:'giờ'}},payment:['momo','cash'],open:'24/7',overnight:true,note:'Bãi đỗ công cộng lớn nhất Q.1. Quét QR MoMo tại quầy khi ra, hoặc trả tiền mặt.',lat:10.7670,lng:106.6880},
  {id:'p4',name:'iParking Phạm Ngọc Thạch',partner:'iparking',icon:'🛵',color:'#7c3aed',color2:'#6d28d9',area:'Quận 3',addr:'8 Phạm Ngọc Thạch, Q.3, TP.HCM',dist:1.4,rating:4.2,vehicles:['xemay'],fees:{xemay:{price:5000,unit:'lần'}},payment:['momo','iparking'],open:'05:30 - 22:30',overnight:false,note:'Bãi xe máy tích hợp iParking Q.3. Nhập biển số khi vào, thanh toán qua MoMo khi ra. Không cần tiền mặt.',lat:10.7788,lng:106.6939},
  {id:'p5',name:'Aeon Mall Tân Phú',partner:'eparking',icon:'🛒',color:'#b45309',color2:'#92400e',area:'Tân Phú',addr:'30 Bờ Bao Tân Thắng, Q.Tân Phú, TP.HCM',dist:4.2,rating:4.4,vehicles:['xemay','oto'],fees:{xemay:{price:5000,unit:'lần'},oto:{price:15000,unit:'giờ'}},payment:['momo','eparking'],open:'08:00 - 22:30',overnight:false,note:'Bãi đỗ TTTM tích hợp eParking. Nạp tiền eParking qua MoMo trước, vào ra tự động. Miễn phí 30 phút đầu.',lat:10.7961,lng:106.6261},
  {id:'p6',name:'Crescent Mall PMH',partner:'eparking',icon:'🌙',color:'#0e7490',color2:'#0c4a6e',area:'Quận 7',addr:'101 Tôn Dật Tiên, Q.7, TP.HCM',dist:5.8,rating:4.3,vehicles:['oto'],fees:{oto:{price:12000,unit:'giờ'}},payment:['momo','eparking'],open:'09:00 - 22:00',overnight:false,note:'Bãi đỗ ô tô tầng hầm B1-B3. Hiện đầy chỗ. Vào danh sách chờ hoặc thử lại sau 30 phút.',lat:10.7297,lng:106.7214},
  {id:'p7',name:'VinParking Landmark 81',partner:'vinparking',icon:'🏙',color:'#c2410c',color2:'#9a3412',area:'Bình Thạnh',addr:'720A Điện Biên Phủ, Bình Thạnh, TP.HCM',dist:2.1,rating:4.6,vehicles:['oto'],fees:{oto:{price:25000,unit:'giờ'}},payment:['momo','vetc','vinparking'],open:'24/7',overnight:true,note:'Bãi đỗ ô tô cao cấp tại tòa nhà cao nhất VN. Thanh toán VETC tự động hoặc quét QR MoMo. Có chỗ qua đêm.',lat:10.7948,lng:106.7218},
  {id:'p8',name:'VETC Parking Tân Sơn Nhất',partner:'vetc',icon:'✈️',color:'#1d4ed8',color2:'#1e40af',area:'Tân Bình',addr:'Ga quốc nội, Tân Bình, TP.HCM',dist:7.5,rating:4.0,vehicles:['oto'],fees:{oto:{price:40000,unit:'giờ'}},payment:['momo','vetc'],open:'24/7',overnight:true,note:'Bãi đỗ sân bay Tân Sơn Nhất, tầng 3 nhà xe tự động. Đặt chỗ trước qua App MoMo được giảm 10%.',lat:10.8189,lng:106.6694},
];

const CONDITIONS = [
  {id:'all',label:'Tất cả',icon:''},
  {id:'oto',label:'Ô tô',icon:'🚗'},
  {id:'xemay',label:'Xe máy',icon:'🛵'},
  {id:'24-7',label:'Qua đêm 24/7',icon:''},
];
const PAY_LABELS = {momo:'MoMo',vetc:'VETC',eparking:'eParking',iparking:'iParking',vinparking:'VinParking',cash:'Tiền mặt'};

const S = {cond:'all',selected:null};

function feeDisplay(s){
  if(S.cond==='oto'&&s.fees.oto)return`${s.fees.oto.price.toLocaleString('vi-VN')}đ/${s.fees.oto.unit}`;
  if(S.cond==='xemay'&&s.fees.xemay)return`${s.fees.xemay.price.toLocaleString('vi-VN')}đ/${s.fees.xemay.unit}`;
  const f=s.fees.xemay||s.fees.oto;
  return`từ ${f.price.toLocaleString('vi-VN')}đ/${f.unit}`;
}
function minPrice(s){return Math.min(...Object.values(s.fees).map(f=>f.price))}

function renderFilters(){
  document.getElementById('filterRow').innerHTML=CONDITIONS.map(c=>`
    <button class="filter-chip ${S.cond===c.id?'active':''}" onclick="setCond('${c.id}')">
      ${c.icon?`<span class="icon">${c.icon}</span>`:''}${c.label}
    </button>`).join('');
}

function filtered(){
  let list=SPOTS.filter(s=>{
    if(S.cond==='oto')return s.vehicles.includes('oto');
    if(S.cond==='xemay')return s.vehicles.includes('xemay');
    if(S.cond==='24-7')return s.overnight;
    return true;
  });
  const sort=document.getElementById('sortSelect')?.value||'dist';
  if(sort==='price')list=[...list].sort((a,b)=>minPrice(a)-minPrice(b));
  else list=[...list].sort((a,b)=>a.dist-b.dist);
  return list;
}

function vehicleLabel(s){return s.vehicles.map(v=>v==='oto'?'Ô tô':'Xe máy').join(' & ')}

function renderList(){
  const list=filtered();
  const condLabel=CONDITIONS.find(c=>c.id===S.cond)?.label||'Tất cả';
  document.getElementById('listTitle').textContent=`${list.length} bãi đỗ`;
  document.getElementById('listSub').textContent=`Quận 1, TP.HCM · ${condLabel}`;
  document.getElementById('mapCount').textContent=`${list.length} bãi đỗ`;
  document.getElementById('spotList').innerHTML=list.map(s=>{
    const logo=PARTNER_LOGOS[s.partner];
    return`<div class="m-card ${S.selected===s.id?'active':''}" onclick="selectSpot('${s.id}')" onmouseenter="hoverSpot('${s.id}')" onmouseleave="hoverSpot(null)">
      <div class="m-logo">
        ${logo?`<img src="${logo}" alt="${s.name}" referrerpolicy="no-referrer" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'">`:'' }
        <div class="m-logo-fallback" style="--bc:${s.color};--bc2:${s.color2};${logo?'display:none':''}">${s.icon}</div>
      </div>
      <div class="m-body">
        <div class="m-header">
          <div class="m-name">${s.name}</div>
          <span class="m-rating">★ ${s.rating}</span>
          <span class="m-dist-wrap">${s.dist} km</span>
        </div>
        <div class="m-meta">
          <span class="badge-floor">${s.area}</span>
          <span class="badge-cat">${vehicleLabel(s)}</span>
        </div>
        <div class="m-addr">${s.addr}</div>
        <div class="m-badges"><span class="badge-fee">${feeDisplay(s)}</span></div>
      </div>
    </div>`;
  }).join('');
  updateMapMarkers(list);
}

function selectSpot(id){
  S.selected=id;renderList();
  const s=SPOTS.find(x=>x.id===id);if(!s)return;
  const logo=PARTNER_LOGOS[s.partner];
  document.getElementById('detailIcon').innerHTML=logo?`<img src="${logo}" alt="${s.name}" referrerpolicy="no-referrer">`:`<div style="width:100%;height:100%;display:grid;place-items:center;font-size:26px;background:linear-gradient(135deg,${s.color},${s.color2})">${s.icon}</div>`;
  document.getElementById('detailName').textContent=s.name;
  document.getElementById('detailAddr').textContent=s.addr;
  document.getElementById('detailHours').textContent=`${s.open}${s.overnight?' · Có gửi qua đêm':''}`;
  document.getElementById('detailStatus').innerHTML=`<span class="badge-fee">${feeDisplay(s)}</span>`;
  const hero=document.getElementById('detailHero');
  hero.style.background=`linear-gradient(135deg,${s.color} 0%,${s.color2} 100%)`;
  document.getElementById('detailHeroLogo').innerHTML=logo?`<img src="${logo}" alt="" referrerpolicy="no-referrer">`:`<span>${s.icon}</span>`;
  document.getElementById('momoOverlayText').innerHTML=`<strong>Không cần tiền mặt</strong>Vào ra tự động, phí trừ qua ví MoMo`;
  document.getElementById('detailGrid').innerHTML=`
    <div class="detail-cell"><div class="dc-lbl">Giờ mở cửa</div><div class="dc-val">${s.open}</div></div>
    ${s.fees.xemay?`<div class="detail-cell"><div class="dc-lbl">Xe máy</div><div class="dc-val">${s.fees.xemay.price.toLocaleString('vi-VN')}đ/${s.fees.xemay.unit}</div></div>`:''}
    ${s.fees.oto?`<div class="detail-cell"><div class="dc-lbl">Ô tô</div><div class="dc-val">${s.fees.oto.price.toLocaleString('vi-VN')}đ/${s.fees.oto.unit}</div></div>`:''}`;
  document.getElementById('detailPay').innerHTML=s.payment.map(k=>`<span class="pay-tag ${k}">${PAY_LABELS[k]||k}</span>`).join('');
  document.getElementById('detailDesc').textContent=s.note;
  const cta=document.getElementById('detailCTA');
  cta.textContent='Dùng ngay qua MoMo';
  cta.onclick=()=>toast(`Đang mở ${s.name} trên MoMo...`);
  document.body.classList.add('has-detail');
  updateMapMarkers(filtered());
  if(map)map.flyTo({center:[s.lng,s.lat],zoom:15.5,duration:700});
}

function closeDetail(){
  S.selected=null;document.body.classList.remove('has-detail');renderList();fitAll();
}
document.getElementById('detailClose').onclick=closeDetail;
document.getElementById('detailBack').onclick=closeDetail;

let map;
const markerMap={};

function initMap(){
  map=new maplibregl.Map({container:'map',style:'https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json',center:[106.7029,10.7769],zoom:12,attributionControl:{compact:false}});
  const userEl=document.createElement('div');userEl.className='gl-user-dot';
  new maplibregl.Marker({element:userEl}).setLngLat([106.6984,10.7740]).addTo(map);
  new maplibregl.Popup({closeButton:false,closeOnClick:false,offset:[14,0],anchor:'left'}).setLngLat([106.6984,10.7740]).setText('Bạn đây').addTo(map);
  updateMapMarkers(SPOTS);fitAll();
}

function pillEl(s){
  const el=document.createElement('div');el.className='gl-pill';
  el.style.setProperty('--pc','#D97706');
  el.textContent='🅿';
  el.addEventListener('click',e=>{e.stopPropagation();selectSpot(s.id)});
  return el;
}

function setPillState(id,state){
  const entry=markerMap[id];if(!entry)return;
  entry.el.classList.toggle('active',state==='active');
  entry.el.classList.toggle('hover',state==='hover');
}

function updateMapMarkers(list){
  if(!map)return;
  Object.values(markerMap).forEach(e=>e.marker.remove());
  Object.keys(markerMap).forEach(k=>delete markerMap[k]);
  list.forEach(s=>{
    const el=pillEl(s);
    const marker=new maplibregl.Marker({element:el}).setLngLat([s.lng,s.lat]).addTo(map);
    markerMap[s.id]={marker,el};
    if(S.selected===s.id)setPillState(s.id,'active');
  });
}

function hoverSpot(id){
  filtered().forEach(s=>{setPillState(s.id,S.selected===s.id?'active':s.id===id?'hover':'default')});
}

function fitAll(){
  const list=filtered();if(!map||!list.length)return;
  const b=new maplibregl.LngLatBounds();
  list.forEach(s=>b.extend([s.lng,s.lat]));
  map.fitBounds(b,{padding:60,duration:600,maxZoom:15});
}

function setCond(id){
  S.cond=id;S.selected=null;
  document.body.classList.remove('has-detail');
  renderFilters();renderList();fitAll();
}
function render(){renderList()}

document.getElementById('ctrlZoomIn').addEventListener('click',()=>map?.zoomIn());
document.getElementById('ctrlZoomOut').addEventListener('click',()=>map?.zoomOut());

let toastTimer;
function toast(msg){
  const el=document.getElementById('toast');
  el.textContent=msg;el.classList.add('show');
  clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2800);
}

renderFilters();initMap();renderList();

window.addEventListener('load',()=>{
  if(window.lucide){lucide.createIcons();}
});
</script>

</VehicleHub>
