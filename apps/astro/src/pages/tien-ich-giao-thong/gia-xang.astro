      return `<div class="gz-price-card${i===0?' active':''}" onclick="selectFuelCard(this,${i})">
        <div class="gz-pc-icon" style="background:${f.bg}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="${f.color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${licon(f.icon,16,2).replace(/<svg[^>]*>/,'').replace('</svg>','')}</svg>
        </div>
        <div class="gz-pc-name">${f.name}</div>
        <div class="gz-pc-price"><span class="gz-count" data-target="${f.price}" data-delay="${i * 80}">0</span> <span>đ/lít</span></div>
        <div class="gz-pc-delta ${dir}">${arrow} ${Math.abs(f.delta)}đ (${f.pct})</div>
        <div class="gz-pc-vs">So với kỳ trước</div>
        ${buildSparkline(f.history, f.color)}
