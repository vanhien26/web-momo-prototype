/* ── NAV VEHICLE SEARCH ── */
(function() {
  const VEHICLE_DATA = [
    {brand:'toyota',label:'Toyota',color:'#EB0A1E',cat:'Ô tô',models:[{name:'Fortuner',slug:'fortuner',type:'SUV'},{name:'Camry',slug:'camry',type:'Sedan'},{name:'Corolla Cross',slug:'corolla-cross',type:'Crossover'},{name:'Innova Cross',slug:'innova-cross',type:'MPV'}]},
