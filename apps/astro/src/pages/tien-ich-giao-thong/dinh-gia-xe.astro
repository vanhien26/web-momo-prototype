<script is:inline>
// ── DATA ──
const BRANDS=[
  {id:'toyota',name:'Toyota',logo:'https://upload.wikimedia.org/wikipedia/commons/9/9d/Toyota_carlogo.svg'},
  {id:'honda',name:'Honda',logo:'https://upload.wikimedia.org/wikipedia/commons/7/76/Honda_logo.svg'},
  {id:'hyundai',name:'Hyundai',logo:'https://upload.wikimedia.org/wikipedia/commons/1/1b/Hyundai_Motor_Company_logo.svg'},
  {id:'kia',name:'KIA',logo:'https://upload.wikimedia.org/wikipedia/commons/1/13/Kia-logo.svg'},
  {id:'mazda',name:'Mazda',logo:'https://upload.wikimedia.org/wikipedia/commons/e/e0/Mazda_logo.svg'},
  {id:'ford',name:'Ford',logo:'https://upload.wikimedia.org/wikipedia/commons/3/3e/Ford_logo_flat.svg'},
  {id:'mitsubishi',name:'Mitsubishi',logo:'https://upload.wikimedia.org/wikipedia/commons/8/8b/Mitsubishi_logo.svg'},
  {id:'vinfast',name:'VinFast',logo:'https://homepage.momocdn.net/img/momo-upload-api-240411101101-638482506617370879.png'},
  {id:'mercedes',name:'Mercedes',logo:'https://upload.wikimedia.org/wikipedia/commons/9/90/Mercedes-Logo.svg'},
  {id:'bmw',name:'BMW',logo:'https://upload.wikimedia.org/wikipedia/commons/4/44/BMW.svg'},
  {id:'audi',name:'Audi',logo:'https://upload.wikimedia.org/wikipedia/commons/7/7f/Audi_logo_detail.svg'},
  {id:'nissan',name:'Nissan',logo:'https://upload.wikimedia.org/wikipedia/commons/2/26/Nissan_2020_logo.svg'},
];
const MODELS_MAP={
  toyota:[{id:'vios',name:'Vios',sub:'Sedan hạng B'},{id:'camry',name:'Camry',sub:'Sedan hạng D'},{id:'fortuner',name:'Fortuner',sub:'SUV 7 chỗ'},{id:'innova',name:'Innova Cross',sub:'MPV 7 chỗ'},{id:'corolla-cross',name:'Corolla Cross',sub:'SUV hạng C'},{id:'hilux',name:'Hilux',sub:'Bán tải'}],
  honda:[{id:'city',name:'City',sub:'Sedan hạng B'},{id:'crv',name:'CR-V',sub:'SUV 5 chỗ'},{id:'hrv',name:'HR-V',sub:'SUV hạng B'},{id:'civic',name:'Civic',sub:'Sedan hạng C'},{id:'accord',name:'Accord',sub:'Sedan hạng E'}],
  hyundai:[{id:'accent',name:'Accent',sub:'Sedan hạng B'},{id:'tucson',name:'Tucson',sub:'SUV 5 chỗ'},{id:'santa-fe',name:'Santa Fe',sub:'SUV 7 chỗ'},{id:'creta',name:'Creta',sub:'SUV hạng B+'},{id:'i10',name:'Grand i10',sub:'Hatchback'}],
  kia:[{id:'morning',name:'Morning',sub:'Hatchback'},{id:'seltos',name:'Seltos',sub:'SUV hạng B+'},{id:'sportage',name:'Sportage',sub:'SUV hạng C'},{id:'carnival',name:'Carnival',sub:'MPV cao cấp'},{id:'k5',name:'K5',sub:'Sedan hạng D'}],
  mazda:[{id:'mazda2',name:'Mazda2',sub:'Sedan hạng B'},{id:'mazda3',name:'Mazda3',sub:'Sedan hạng C'},{id:'cx5',name:'CX-5',sub:'SUV hạng C'},{id:'cx8',name:'CX-8',sub:'SUV 7 chỗ'},{id:'bt50',name:'BT-50',sub:'Bán tải'}],
  ford:[{id:'ranger',name:'Ranger',sub:'Bán tải'},{id:'everest',name:'Everest',sub:'SUV 7 chỗ'},{id:'territory',name:'Territory',sub:'SUV hạng C'},{id:'explorer',name:'Explorer',sub:'SUV hạng E'}],
  mitsubishi:[{id:'xpander',name:'Xpander',sub:'MPV 7 chỗ'},{id:'outlander',name:'Outlander',sub:'SUV hạng D'},{id:'attrage',name:'Attrage',sub:'Sedan hạng B'},{id:'pajero',name:'Pajero Sport',sub:'SUV 7 chỗ'}],
  vinfast:[{id:'vf5',name:'VF 5',sub:'SUV điện'},{id:'vf6',name:'VF 6',sub:'SUV hạng B điện'},{id:'vf7',name:'VF 7',sub:'SUV hạng C điện'},{id:'vf8',name:'VF 8',sub:'SUV hạng D điện'},{id:'vf9',name:'VF 9',sub:'SUV 7 chỗ điện'}],
  mercedes:[{id:'c200',name:'C 200',sub:'Sedan hạng E'},{id:'e300',name:'E 300',sub:'Sedan hạng F'},{id:'glc',name:'GLC',sub:'SUV hạng D'},{id:'gle',name:'GLE',sub:'SUV hạng E'}],
  bmw:[{id:'3series',name:'3 Series',sub:'Sedan hạng E'},{id:'5series',name:'5 Series',sub:'Sedan hạng F'},{id:'x3',name:'X3',sub:'SUV hạng D'},{id:'x5',name:'X5',sub:'SUV hạng E'}],
  audi:[{id:'a4',name:'A4',sub:'Sedan hạng E'},{id:'a6',name:'A6',sub:'Sedan hạng F'},{id:'q5',name:'Q5',sub:'SUV hạng D'},{id:'q7',name:'Q7',sub:'SUV 7 chỗ'}],
  nissan:[{id:'navara',name:'Navara',sub:'Bán tải'},{id:'terra',name:'Terra',sub:'SUV 7 chỗ'},{id:'almera',name:'Almera',sub:'Sedan hạng B'}],
};
const BASE_PRICES={
  'toyota-vios':750,'toyota-camry':1350,'toyota-fortuner':1400,'toyota-innova':1050,'toyota-corolla-cross':870,'toyota-hilux':850,
  'honda-city':540,'honda-crv':1150,'honda-hrv':750,'honda-civic':870,'honda-accord':1350,
  'hyundai-accent':480,'hyundai-tucson':850,'hyundai-santa-fe':1280,'hyundai-creta':650,'hyundai-i10':380,
  'kia-morning':430,'kia-seltos':680,'kia-sportage':950,'kia-carnival':1500,'kia-k5':1150,
  'mazda-mazda2':510,'mazda-mazda3':750,'mazda-cx5':900,'mazda-cx8':1180,'mazda-bt50':720,
  'ford-ranger':750,'ford-everest':1300,'ford-territory':820,'ford-explorer':2200,
  'mitsubishi-xpander':680,'mitsubishi-outlander':1200,'mitsubishi-attrage':510,'mitsubishi-pajero':1250,
  'vinfast-vf5':550,'vinfast-vf6':700,'vinfast-vf7':950,'vinfast-vf8':1200,'vinfast-vf9':1500,
  'mercedes-c200':1800,'mercedes-e300':2600,'mercedes-glc':2400,'mercedes-gle':3600,
  'bmw-3series':2000,'bmw-5series':2900,'bmw-x3':2400,'bmw-x5':4000,
  'audi-a4':1900,'audi-a6':2800,'audi-q5':2400,'audi-q7':3800,
  'nissan-navara':820,'nissan-terra':1050,'nissan-almera':480,
};
const DEPR=[1,.92,.84,.76,.69,.63,.57,.52,.47,.43];
const COND_M={'can-sua':.82,'trung-binh':.93,'tot':1,'rat-tot':1.05};

const SEARCH_LIST=[];
BRANDS.forEach(b=>(MODELS_MAP[b.id]||[]).forEach(m=>{
  SEARCH_LIST.push({brandId:b.id,brandName:b.name,logo:b.logo,modelId:m.id,modelName:m.name,sub:m.sub,fullName:`${b.name} ${m.name}`,baseNew:BASE_PRICES[`${b.id}-${m.id}`]||900});
}));

const S={entry:null,year:new Date().getFullYear(),km:0,cond:'tot',condName:'Tốt'};

function initYearSelect(){
  const sel=document.getElementById('yearSelect');
  if(!sel)return;
  const cur=new Date().getFullYear();
  for(let y=cur;y>=2011;y--){
    const o=document.createElement('option');
    o.value=y; o.textContent=y;
    if(y===cur) o.selected=true;
    sel.appendChild(o);
  }
  S.year=cur;
}

window.onSearch=function(q){
  const dd=document.getElementById('searchDropdown');
  const clr=document.getElementById('searchClear');
  if(!dd||!clr)return;
  clr.classList.toggle('visible',q.length>0);
  if(!q.trim()){dd.classList.remove('open');return;}
  const hits=SEARCH_LIST.filter(e=>e.fullName.toLowerCase().includes(q.toLowerCase())||e.modelName.toLowerCase().includes(q.toLowerCase())).slice(0,8);
  if(!hits.length){dd.classList.remove('open');return;}
  dd.innerHTML=hits.map(e=>{
    const lo=fmt(Math.round(e.baseNew*.63));
    const hi=fmt(Math.round(e.baseNew*1.0));
    return `<div class="dd-item" tabindex="0" onclick='selectEntry(${JSON.stringify(e).replace(/'/g, "\\'")})'>
      <img class="dd-logo" src="${e.logo}" alt="" onerror="this.style.display='none'">
      <div class="dd-name">${e.fullName} <small>${e.sub}</small></div>
      <div class="dd-price">Xe cũ ${lo} – ${hi}</div>
    </div>`;
  }).join('');
  dd.classList.add('open');
}

window.selectEntry=function(e){
  S.entry=e;
  const inp=document.getElementById('searchInput');
  const dd=document.getElementById('searchDropdown');
  const clr=document.getElementById('searchClear');
  const btn=document.getElementById('calcBtn');
  if(inp) inp.value=e.fullName;
  if(dd) dd.classList.remove('open');
  if(clr) clr.classList.add('visible');
  if(btn) btn.disabled=false;
}

window.clearSearch=function(){
  S.entry=null;
  const inp=document.getElementById('searchInput');
  const dd=document.getElementById('searchDropdown');
  const clr=document.getElementById('searchClear');
  const btn=document.getElementById('calcBtn');
  if(inp) inp.value='';
  if(dd) dd.classList.remove('open');
  if(clr) clr.classList.remove('visible');
  if(btn) btn.disabled=true;
}

window.selectCond=function(id,name,el){
  S.cond=id;S.condName=name;
  document.querySelectorAll('.cond-pill').forEach(b=>b.classList.remove('sel'));
  if(el) el.classList.add('sel');
}

window.calculate=function(){
  if(!S.entry)return;
  const e=S.entry;
  const yearSelect=document.getElementById('yearSelect');
  const kmInput=document.getElementById('kmInput');
  const year=parseInt(yearSelect?yearSelect.value:new Date().getFullYear());
  const km=parseInt(kmInput?kmInput.value:0)||0;
  S.year=year; S.km=km;
  const cur=new Date().getFullYear();
  const age=Math.max(0,cur-year);
  const retain=DEPR[Math.min(age,DEPR.length-1)];
  const cMult=COND_M[S.cond]||1;
  let kAdj=1;
  if(km>150000)kAdj=.88; else if(km>80000)kAdj=.94; else if(km<20000)kAdj=1.03;
  const mid=Math.round(e.baseNew*retain*kAdj*cMult);
  const finLow=Math.round(mid*.90),finHigh=Math.round(mid*.97);
  const buyLow=Math.round(mid*.95),buyHigh=Math.round(mid*1.07);
  const insPct=mid>1500?.016:mid>800?.018:.02;
  const insAmt=Math.round(mid*insPct);
  const deprAmt=Math.round(e.baseNew*(1-retain));
  const kmAdj=Math.round(e.baseNew*retain*(kAdj-1));
  const condAdj=Math.round(e.baseNew*retain*kAdj*(cMult-1));
  showResult({e,year,km,mid,finLow,finHigh,buyLow,buyHigh,insAmt,deprAmt,kmAdj,condAdj});
}

function fmt(n){return n>=1000?(n/1000).toFixed(1).replace('.0','')+' tỷ':n+' triệu';}
function fmtAdj(n){
  if(n===0)return '<span style="color:var(--gray-400)">Không đổi</span>';
  const s=n>0?'+':'';const c=n>0?'pos':'neg';
  return `<span class="bc-row-val ${c}">${s}${fmt(Math.abs(n))}</span>`;
}

function showResult(r){
  const kmLabel=r.km>=1000?Math.round(r.km/1000)+'k km':r.km+' km';
  const rCarName=document.getElementById('rCarName');
  if(rCarName) rCarName.textContent=r.e.fullName;
  const rYearTag=document.getElementById('rYearTag');
  if(rYearTag) rYearTag.textContent=r.year;
  const rKmTag=document.getElementById('rKmTag');
  if(rKmTag) rKmTag.textContent=kmLabel;
  const rCondTag=document.getElementById('rCondTag');
  if(rCondTag) rCondTag.textContent=S.condName;
  const rPriceLow=document.getElementById('rPriceLow');
  if(rPriceLow) rPriceLow.textContent=`${fmt(r.finLow)} – ${fmt(r.finHigh)}`;
  const rPriceMid=document.getElementById('rPriceMid');
  if(rPriceMid) rPriceMid.textContent=`${fmt(r.buyLow)} – ${fmt(r.buyHigh)}`;
  const rPriceIns=document.getElementById('rPriceIns');
  if(rPriceIns) rPriceIns.textContent=`~${fmt(r.insAmt)}/năm`;
  const insPrice=document.getElementById('insPrice');
  if(insPrice) insPrice.textContent=`~${fmt(r.insAmt)}`;
  const bBase=document.getElementById('bBase');
  if(bBase) bBase.textContent=fmt(r.e.baseNew);
  const bDepr=document.getElementById('bDepr');
  if(bDepr) bDepr.innerHTML=`-${fmt(r.deprAmt)}`;
  const bKm=document.getElementById('bKm');
  if(bKm) bKm.innerHTML=fmtAdj(r.kmAdj);
  const bCond=document.getElementById('bCond');
  if(bCond) bCond.innerHTML=fmtAdj(r.condAdj);
  const bFinal=document.getElementById('bFinal');
  if(bFinal) bFinal.textContent=fmt(r.mid);

  const r1=r.mid+Math.round((Math.random()-.3)*r.mid*.06);
  const r2=r.mid+Math.round((Math.random()-.2)*r.mid*.12);
  const srcMomo=document.getElementById('srcMomo');
  if(srcMomo) srcMomo.textContent=`${fmt(r.finLow)} – ${fmt(r.buyHigh)}`;
  const srcBonbanh=document.getElementById('srcBonbanh');
  if(srcBonbanh) srcBonbanh.textContent=`${fmt(Math.round(r1*.95))} – ${fmt(r1)}`;
  const srcBonbanhTB=document.getElementById('srcBonbanhTB');
  if(srcBonbanhTB) srcBonbanhTB.textContent=`TB ${fmt(r1)}`;
  const srcChotot=document.getElementById('srcChotot');
  if(srcChotot) srcChotot.textContent=`${fmt(Math.round(r2*.92))} – ${fmt(r2)}`;
  const srcChotTB=document.getElementById('srcChotTB');
  if(srcChotTB) srcChotTB.textContent=`${Math.round(Math.random()*4+2)} tin đăng`;

  const rs=document.getElementById('resultSection');
  const uncalc=document.getElementById('uncalcState');
  if(rs) rs.style.display='block';
  if(uncalc) uncalc.style.display='none';
  setTimeout(()=>rs?.scrollIntoView({behavior:'smooth',block:'start'}),80);
}

window.scrollToForm=function(){
  document.querySelector('.hero-form')?.scrollIntoView({behavior:'smooth',block:'center'});
}

document.addEventListener('DOMContentLoaded', () => {
  initYearSelect();

  // Auto-parse query params if passed: ?brand=toyota&model=vios
  const params = new URLSearchParams(window.location.search);
  const brand = params.get('brand');
  const model = params.get('model');
  if (brand && model) {
    const entry = SEARCH_LIST.find(e => e.brandId === brand && e.modelId === model);
    if (entry) {
      selectEntry(entry);
    }
  }
});
</script>
