---
import VehicleHub from '../../layouts/VehicleHub.astro';
---

<VehicleHub
  title="Cứu Hộ Xe Khẩn Cấp 24/7 | MoMo"
  description="Gọi cứu hộ xe trong 30 giây qua MoMo - đội cứu hộ gần nhất đến trong 30 phút, chi phí niêm yết rõ ràng, thanh toán không tiền mặt."
  theme="official"
>

<style is:global>
:root {
  --pink:#EB2F96;--pink-dim:rgba(235,47,150,.1);--pink-light:#fce7f3;
  --green:#22c55e;--green-dim:rgba(34,197,94,.1);
  --amber:#f59e0b;--amber-dim:rgba(245,158,11,.1);
  --red:#ef4444;--red-dim:rgba(239,68,68,.1);
  --blue:#3b82f6;--blue-dim:rgba(59,130,246,.1);
  --g0:#fff;--g50:#f8f9fa;--g100:#f1f3f5;--g200:#e9ecef;
  --g300:#dee2e6;--g400:#adb5bd;--g500:#868e96;
  --g600:#495057;--g700:#343a40;--g800:#212529;--g900:#0d0f12;
  --hd:#0d111c;
  --r8:8px;--r10:10px;--r12:12px;--r16:16px;--r20:20px;
  --sh:0 1px 3px rgba(0,0,0,.06),0 1px 2px rgba(0,0,0,.04);
  --sh2:0 4px 16px rgba(0,0,0,.08),0 2px 4px rgba(0,0,0,.04);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{overflow-x:hidden;height:auto !important;overflow-y:auto !important}
body{font-family:'MoMo Trust Sans',-apple-system,sans-serif;color:var(--g800);background:var(--g50);-webkit-font-smoothing:antialiased;display:block !important}
a{text-decoration:none;color:inherit}
button{cursor:pointer;border:none;background:none;font:inherit;-webkit-tap-highlight-color:transparent}
svg{display:block}
input,select{font:inherit}

/* ── HERO ── */
.hero{position:relative;overflow:hidden;background:var(--hd);border-bottom:1px solid rgba(255,255,255,.06)}
.hero-glow{position:absolute;inset:0;background:radial-gradient(ellipse 55% 100% at 100% 50%,rgba(239,68,68,.14) 0%,transparent 70%),radial-gradient(ellipse 40% 80% at 0% 100%,rgba(235,47,150,.1) 0%,transparent 60%);pointer-events:none}
.hero-inner{position:relative;z-index:2;max-width:1280px;margin:0 auto;padding:46px 20px 42px;display:grid;grid-template-columns:1fr 380px;gap:48px;align-items:center}
.hero-eyebrow{display:inline-flex;align-items:center;gap:7px;font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:rgba(239,68,68,.95);margin-bottom:12px}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--red);animation:blink 1.4s infinite;flex-shrink:0}
@keyframes blink{0%,100%{opacity:.4}50%{opacity:1}}
.hero-h1{font-size:clamp(30px,3.5vw,44px);font-weight:900;line-height:1.08;letter-spacing:-1px;color:#fff;margin-bottom:16px}
.hero-h1 em{font-style:normal;color:var(--pink)}
.hero-sub{font-size:14.5px;color:rgba(255,255,255,.6);line-height:1.6;max-width:520px;margin-bottom:24px}
.hero-cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:28px}
.hero-cta{display:inline-flex;align-items:center;gap:8px;padding:13px 24px;background:var(--pink);color:#fff;border-radius:12px;font-size:14px;font-weight:800;transition:background .15s}
.hero-cta:hover{background:#c2267d}
.hero-cta-ghost{display:inline-flex;align-items:center;gap:8px;padding:13px 20px;background:rgba(255,255,255,.07);border:1.5px solid rgba(255,255,255,.15);color:#fff;border-radius:12px;font-size:14px;font-weight:700;transition:background .15s}
.hero-cta-ghost:hover{background:rgba(255,255,255,.12)}
.hero-stats{display:flex;gap:0;border:1px solid rgba(255,255,255,.1);border-radius:12px;overflow:hidden;background:rgba(255,255,255,.04);max-width:520px}
.hero-stat{flex:1;padding:12px 16px;border-right:1px solid rgba(255,255,255,.08);text-align:center}
.hero-stat:last-child{border-right:none}
.hero-stat-val{font-size:18px;font-weight:900;color:#fff;line-height:1}
.hero-stat-val em{font-style:normal;color:var(--pink)}
.hero-stat-lbl{font-size:10.5px;font-weight:600;color:rgba(255,255,255,.4);margin-top:4px}
/* hero right: live rescue card */
.hero-card{background:rgba(255,255,255,.06);border:1.5px solid rgba(255,255,255,.1);border-radius:16px;padding:20px 22px;backdrop-filter:blur(8px)}
.hero-card-title{display:flex;align-items:center;justify-content:space-between;font-size:11px;font-weight:800;color:rgba(255,255,255,.45);letter-spacing:.08em;text-transform:uppercase;margin-bottom:16px}
.hero-card-badge{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:700;color:var(--green);background:rgba(34,197,94,.12);padding:3px 8px;border-radius:99px;letter-spacing:0;text-transform:none}
.rescue-track{display:flex;flex-direction:column;gap:0}
.rt-row{display:flex;gap:12px}
.rt-rail{display:flex;flex-direction:column;align-items:center;width:20px;flex-shrink:0}
.rt-dot{width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.rt-dot.done{background:rgba(34,197,94,.2);color:var(--green)}
.rt-dot.active{background:var(--pink);color:#fff;box-shadow:0 0 0 4px rgba(235,47,150,.2)}
.rt-dot.wait{background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.15)}
.rt-line{width:2px;flex:1;min-height:18px;background:rgba(255,255,255,.1);margin:3px 0}
.rt-line.done{background:rgba(34,197,94,.35)}
.rt-body{padding-bottom:16px;min-width:0}
.rt-row:last-child .rt-body{padding-bottom:0}
.rt-title{font-size:13px;font-weight:700;color:rgba(255,255,255,.9);line-height:1.3}
.rt-title.dim{color:rgba(255,255,255,.4);font-weight:500}
.rt-sub{font-size:11.5px;color:rgba(255,255,255,.45);margin-top:2px;line-height:1.45}
.rt-eta{display:inline-flex;align-items:center;gap:5px;margin-top:7px;font-size:11px;font-weight:800;color:var(--pink);background:rgba(235,47,150,.12);padding:4px 9px;border-radius:7px}
@media(max-width:900px){
  .hero-inner{grid-template-columns:1fr;gap:26px;padding:34px 16px 32px}
  .hero-h1{font-size:28px}
  .hero-card{display:none}
}

/* ── BREADCRUMB ── */
.crumbs{max-width:1280px;margin:0 auto;padding:14px 20px 0;display:flex;align-items:center;gap:6px;font-size:12px;color:var(--g400);flex-wrap:wrap}
.crumbs a{color:var(--g500);font-weight:600}
.crumbs a:hover{color:var(--pink)}
.crumbs .sep{color:var(--g300)}
.crumbs strong{color:var(--g800);font-weight:700}

/* ── SECTIONS ── */
.wrap{max-width:1280px;margin:0 auto;padding:0 20px}
.section{padding:44px 0 8px}
.sec-eyebrow{font-size:10.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--pink);margin-bottom:8px}
.sec-title{font-size:clamp(22px,2.4vw,30px);font-weight:900;letter-spacing:-.5px;color:var(--g900);line-height:1.15;margin-bottom:10px}
.sec-desc{font-size:14px;color:var(--g500);line-height:1.6;max-width:640px}

/* ── FLOW ── */
.flow{position:relative;margin-top:30px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.flow::before{content:'';position:absolute;top:26px;left:8%;right:8%;height:2px;background:linear-gradient(90deg,var(--pink) 0%,var(--pink-light) 100%);z-index:0}
.flow-step{position:relative;z-index:1;background:#fff;border:1.5px solid var(--g100);border-radius:var(--r16);padding:22px;box-shadow:var(--sh)}
.flow-num{width:52px;height:52px;border-radius:14px;background:var(--pink-dim);color:var(--pink);display:flex;align-items:center;justify-content:center;margin-bottom:14px;position:relative}
.flow-badge{position:absolute;top:-6px;right:-6px;width:20px;height:20px;border-radius:50%;background:var(--pink);color:#fff;font-size:10px;font-weight:900;display:flex;align-items:center;justify-content:center;border:2px solid #fff}
.flow-title{font-size:15.5px;font-weight:800;color:var(--g900);margin-bottom:6px}
.flow-desc{font-size:12.5px;color:var(--g500);line-height:1.6}
.flow-hint{display:inline-flex;align-items:center;gap:6px;margin-top:12px;font-size:11px;font-weight:700;color:var(--g600);background:var(--g50);border:1px solid var(--g100);padding:5px 10px;border-radius:8px}
@media(max-width:820px){
  .flow{grid-template-columns:1fr;gap:0}
  .flow::before{top:0;bottom:0;left:25px;right:auto;width:2px;height:auto;background:linear-gradient(180deg,var(--pink) 0%,var(--pink-light) 100%)}
  .flow-step{margin-left:52px;margin-bottom:14px}
  .flow-num{position:absolute;left:-52px;top:18px;width:36px;height:36px;border-radius:50%;background:#fff;border:2px solid var(--pink);margin:0}
  .flow-num svg{width:16px;height:16px}
  .flow-badge{display:none}
}

/* ── PARTNER CARDS ── */
.partner-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:26px}
.partner-card{background:#fff;border:1.5px solid var(--g100);border-radius:var(--r16);padding:24px;box-shadow:var(--sh);display:flex;flex-direction:column;transition:border-color .15s,box-shadow .15s}
.partner-card:hover{border-color:rgba(235,47,150,.3);box-shadow:var(--sh2)}
.partner-top{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.partner-logo{width:52px;height:52px;border-radius:12px;background:var(--g50);border:1px solid var(--g100);display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0}
.partner-logo img{width:100%;height:100%;object-fit:contain;padding:6px}
.partner-logo.mock{color:var(--blue)}
.partner-name{font-size:16.5px;font-weight:800;color:var(--g900)}
.partner-sub{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--g500);margin-top:3px}
.partner-desc{font-size:13px;color:var(--g600);line-height:1.6;margin-bottom:14px}
.partner-tags{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:18px}
.partner-tag{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;color:var(--g600);background:var(--g50);border:1px solid var(--g100);padding:5px 10px;border-radius:99px}
.partner-tag.hl{color:var(--green);background:var(--green-dim);border-color:transparent}
.partner-cta{margin-top:auto;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 18px;background:var(--pink);color:#fff;border-radius:10px;font-size:13px;font-weight:800;transition:background .15s;width:100%}
.partner-cta:hover{background:#c2267d}
.partner-cta.ghost{background:#fff;color:var(--g700);border:1.5px solid var(--g200)}
.partner-cta.ghost:hover{background:var(--g50)}
@media(max-width:820px){.partner-grid{grid-template-columns:1fr}}

/* ── SITUATIONS ── */
.sit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:26px}
.sit-card{background:#fff;border:1.5px solid var(--g100);border-radius:var(--r12);padding:18px;box-shadow:var(--sh);cursor:pointer;transition:border-color .15s,box-shadow .15s}
.sit-card:hover{border-color:rgba(235,47,150,.3);box-shadow:var(--sh2)}
.sit-head{display:flex;align-items:center;gap:11px;margin-bottom:10px}
.sit-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sit-name{font-size:14px;font-weight:800;color:var(--g900);line-height:1.25}
.sit-cost{font-size:11px;font-weight:700;color:var(--g500);margin-top:2px}
.sit-cost em{font-style:normal;color:var(--pink);font-weight:800}
.sit-tip{font-size:12px;color:var(--g500);line-height:1.55;border-top:1px dashed var(--g200);padding-top:10px}
.sit-tip strong{color:var(--g700)}
@media(max-width:900px){.sit-grid{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.sit-grid{grid-template-columns:1fr}}

/* ── COVERAGE ── */
.coverage{margin-top:44px;background:var(--hd);border-radius:var(--r20);padding:34px 36px;position:relative;overflow:hidden;display:grid;grid-template-columns:1fr auto;gap:28px;align-items:center}
.coverage::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 50% 120% at 90% 50%,rgba(235,47,150,.15) 0%,transparent 65%)}
.coverage>*{position:relative;z-index:1}
.coverage-title{font-size:clamp(19px,2vw,25px);font-weight:900;color:#fff;letter-spacing:-.4px;line-height:1.2;margin-bottom:8px}
.coverage-title em{font-style:normal;color:var(--pink)}
.coverage-sub{font-size:13px;color:rgba(255,255,255,.55);line-height:1.6;max-width:460px}
.coverage-stats{display:flex;gap:26px}
.cov-stat{text-align:center}
.cov-val{font-size:26px;font-weight:900;color:#fff;line-height:1}
.cov-val em{font-style:normal;color:var(--pink)}
.cov-lbl{font-size:11px;font-weight:600;color:rgba(255,255,255,.45);margin-top:5px}
@media(max-width:820px){.coverage{grid-template-columns:1fr;padding:26px 22px}.coverage-stats{gap:0;justify-content:space-between}}

/* ── FAQ ── */
.faq-list{margin-top:24px;display:flex;flex-direction:column;gap:10px;max-width:760px}
.faq-item{background:#fff;border:1.5px solid var(--g100);border-radius:var(--r12);overflow:hidden;box-shadow:var(--sh)}
.faq-q{width:100%;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:15px 18px;font-size:13.5px;font-weight:700;color:var(--g800);text-align:left;font-family:'MoMo Trust Sans',-apple-system,sans-serif}
.faq-q svg{flex-shrink:0;color:var(--g400);transition:transform .2s}
.faq-item.open .faq-q svg{transform:rotate(180deg);color:var(--pink)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .25s ease}
.faq-a-inner{padding:0 18px 16px;font-size:13px;color:var(--g500);line-height:1.65}
.faq-item.open .faq-a{max-height:220px}

/* ── BACK ── */
.backhub{margin:40px 0 56px;display:flex;justify-content:center}
.backhub a{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--g500);padding:10px 18px;border:1.5px solid var(--g200);border-radius:10px;background:#fff;transition:color .15s,border-color .15s}
.backhub a:hover{color:var(--pink);border-color:rgba(235,47,150,.3)}

/* ── TOAST ── */
.toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(20px);background:var(--g900);color:#fff;font-size:13px;font-weight:600;padding:11px 20px;border-radius:10px;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:999;box-shadow:0 8px 24px rgba(0,0,0,.25)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
</style>

<!-- HERO -->
<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-inner">
    <div>
      <div class="hero-eyebrow"><span class="live-dot"></span>Cứu hộ khẩn cấp · Hoạt động 24/7</div>
      <h1 class="hero-h1">Hỏng xe giữa đường?<br>Gọi cứu hộ trong <em>30 giây</em></h1>
      <p class="hero-sub">Không cần lưu số garage, không cần trả giá giữa đường. Mở MoMo, xác nhận vị trí GPS - đội cứu hộ gần nhất nhận lệnh và đến trong 30 phút, chi phí niêm yết rõ ràng trước khi xác nhận.</p>
      <div class="hero-cta-row">
        <button class="hero-cta" onclick="toast('Mở MoMo App để gọi cứu hộ...')">
          <i data-lucide="phone-call" width="16" height="16"></i>Gọi cứu hộ ngay
        </button>
        <a class="hero-cta-ghost" href="#tinh-huong">
          <i data-lucide="list-checks" width="16" height="16"></i>Xem tình huống thường gặp
        </a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><div class="hero-stat-val"><em>30</em> phút</div><div class="hero-stat-lbl">Thời gian đến TB</div></div>
        <div class="hero-stat"><div class="hero-stat-val"><em>63</em> tỉnh</div><div class="hero-stat-lbl">Phủ sóng toàn quốc</div></div>
        <div class="hero-stat"><div class="hero-stat-val">24/7</div><div class="hero-stat-lbl">Kể cả lễ Tết</div></div>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-card">
        <div class="hero-card-title">
          Theo dõi cứu hộ trực tiếp
          <span class="hero-card-badge"><i data-lucide="radio" width="10" height="10"></i>LIVE</span>
        </div>
        <div class="rescue-track">
          <div class="rt-row">
            <div class="rt-rail"><div class="rt-dot done"><i data-lucide="check" width="10" height="10"></i></div><div class="rt-line done"></div></div>
            <div class="rt-body"><div class="rt-title">Đã tiếp nhận yêu cầu</div><div class="rt-sub">14:02 · Xe máy chết máy, Q.Bình Thạnh</div></div>
          </div>
          <div class="rt-row">
            <div class="rt-rail"><div class="rt-dot done"><i data-lucide="check" width="10" height="10"></i></div><div class="rt-line done"></div></div>
            <div class="rt-body"><div class="rt-title">Tài xế đã nhận lệnh</div><div class="rt-sub">Anh Tuấn · Zuttoride · 4.9★</div></div>
          </div>
          <div class="rt-row">
            <div class="rt-rail"><div class="rt-dot active"><i data-lucide="navigation" width="9" height="9"></i></div><div class="rt-line"></div></div>
            <div class="rt-body">
              <div class="rt-title">Đang di chuyển đến bạn</div>
              <div class="rt-sub">Cách 2,1 km · đường Điện Biên Phủ</div>
              <div class="rt-eta"><i data-lucide="clock" width="11" height="11"></i>Đến sau ~8 phút</div>
            </div>
          </div>
          <div class="rt-row">
            <div class="rt-rail"><div class="rt-dot wait"></div></div>
            <div class="rt-body"><div class="rt-title dim">Hoàn tất &amp; thanh toán MoMo</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="crumbs">
  <a href="/tien-ich-giao-thong">Tiện Ích Giao Thông</a><span class="sep">›</span><strong>Cứu hộ khẩn cấp</strong>
</div>

<!-- FLOW -->
<section class="section wrap">
  <div class="sec-eyebrow">Quy trình</div>
  <h2 class="sec-title">3 bước, không cần gọi điện thoại</h2>
  <p class="sec-desc">Toàn bộ quy trình diễn ra trong App - từ khai báo sự cố đến thanh toán. Không cần đọc địa chỉ qua điện thoại, không cần tiền mặt.</p>
  <div class="flow">
    <div class="flow-step">
      <div class="flow-num"><i data-lucide="map-pin" width="22" height="22"></i><span class="flow-badge">1</span></div>
      <div class="flow-title">Xác nhận vị trí &amp; sự cố</div>
      <div class="flow-desc">GPS tự định vị chính xác nơi bạn đứng. Chọn loại sự cố: chết máy, thủng lốp, hết xăng, hết bình... để đội cứu hộ mang đúng đồ nghề.</div>
      <div class="flow-hint"><i data-lucide="locate-fixed" width="12" height="12"></i>Chia sẻ vị trí cho tài xế</div>
    </div>
    <div class="flow-step">
      <div class="flow-num"><i data-lucide="truck" width="22" height="22"></i><span class="flow-badge">2</span></div>
      <div class="flow-title">Đội cứu hộ gần nhất nhận lệnh</div>
      <div class="flow-desc">Hệ thống điều phối tài xế gần bạn nhất. Xem tên, ảnh, đánh giá của tài xế và theo dõi vị trí di chuyển theo thời gian thực trên bản đồ.</div>
      <div class="flow-hint"><i data-lucide="clock" width="12" height="12"></i>Đến trong ~30 phút</div>
    </div>
    <div class="flow-step">
      <div class="flow-num"><i data-lucide="wallet" width="22" height="22"></i><span class="flow-badge">3</span></div>
      <div class="flow-title">Sửa xong, thanh toán MoMo</div>
      <div class="flow-desc">Chi phí hiển thị trước khi xác nhận - không phát sinh, không trả giá. Sửa tại chỗ hoặc kéo về garage gần nhất, thanh toán một chạm khi hoàn tất.</div>
      <div class="flow-hint"><i data-lucide="receipt" width="12" height="12"></i>Hóa đơn minh bạch trong App</div>
    </div>
  </div>
</section>

<!-- PARTNERS -->
<section class="section wrap">
  <div class="sec-eyebrow">Đối tác cứu hộ</div>
  <h2 class="sec-title">Mạng lưới cứu hộ trên MoMo</h2>
  <p class="sec-desc">Đối tác được thẩm định, chi phí niêm yết, đánh giá công khai sau mỗi chuyến cứu hộ.</p>
  <div class="partner-grid">
    <div class="partner-card">
      <div class="partner-top">
        <div class="partner-logo"><img src="https://static.momocdn.net/app/img/publicservice/logo_zuttoride.png" alt="Zuttoride"></div>
        <div>
          <div class="partner-name">Zuttoride Rescue</div>
          <div class="partner-sub"><i data-lucide="bike" width="13" height="13"></i>Cứu hộ xe máy mọi hãng</div>
        </div>
      </div>
      <p class="partner-desc">Chuẩn cứu hộ Nhật Bản - sửa tại chỗ các lỗi phổ biến (chết máy, thủng lốp, hết bình) hoặc kéo xe về garage liên kết gần nhất nếu cần sửa lớn.</p>
      <div class="partner-tags">
        <span class="partner-tag hl"><i data-lucide="clock" width="11" height="11"></i>Đến trong 30 phút</span>
        <span class="partner-tag"><i data-lucide="map" width="11" height="11"></i>63 tỉnh thành</span>
        <span class="partner-tag"><i data-lucide="wallet" width="11" height="11"></i>Thanh toán MoMo</span>
      </div>
      <button class="partner-cta" onclick="toast('Mở MoMo App để gọi Zuttoride...')"><i data-lucide="phone-call" width="14" height="14"></i>Gọi cứu hộ xe máy</button>
    </div>
    <div class="partner-card">
      <div class="partner-top">
        <div class="partner-logo mock"><i data-lucide="car" width="26" height="26"></i></div>
        <div>
          <div class="partner-name">Cứu hộ ô tô liên kết</div>
          <div class="partner-sub"><i data-lucide="car" width="13" height="13"></i>Kéo xe &amp; sửa lưu động</div>
        </div>
      </div>
      <p class="partner-desc">Mạng lưới xe kéo và thợ lưu động tại các thành phố lớn - câu bình, thay lốp dự phòng, kéo xe về garage. Báo giá theo km hiển thị trước khi xác nhận.</p>
      <div class="partner-tags">
        <span class="partner-tag hl"><i data-lucide="clock" width="11" height="11"></i>Đến trong 45 phút</span>
        <span class="partner-tag"><i data-lucide="building-2" width="11" height="11"></i>HCM · Hà Nội · Đà Nẵng</span>
        <span class="partner-tag"><i data-lucide="wallet" width="11" height="11"></i>Báo giá trước</span>
      </div>
      <button class="partner-cta ghost" onclick="toast('Cứu hộ ô tô đang mở rộng khu vực...')"><i data-lucide="bell" width="14" height="14"></i>Nhận thông báo khi có tại khu vực</button>
    </div>
  </div>
</section>

<!-- SITUATIONS -->
