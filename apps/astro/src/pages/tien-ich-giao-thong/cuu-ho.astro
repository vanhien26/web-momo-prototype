<!-- FAQ -->
<section class="section wrap" style="padding-bottom:0">
  <div class="sec-eyebrow">Câu hỏi thường gặp</div>
  <h2 class="sec-title">Trước khi gọi cứu hộ</h2>
  <div class="faq-list" id="faq-list"></div>
  <div class="backhub"><a href="/tien-ich-giao-thong"><i data-lucide="arrow-left" width="14" height="14"></i>Quay lại Tiện Ích Giao Thông</a></div>
</section>

<div class="toast" id="toast"></div>

<script is:inline>
const SITUATIONS=[
  {icon:'battery-warning',bg:'rgba(245,158,11,.1)',color:'#f59e0b',name:'Hết bình / không đề được',cost:'150K - 300K',tip:'<strong>Xử lý nhanh:</strong> Tắt hết đèn và thiết bị điện. Không cố đề nhiều lần - hại bình và củ đề. Cứu hộ mang bình câu chuyên dụng đến tận nơi.'},
  {icon:'circle-dot',bg:'rgba(239,68,68,.1)',color:'#ef4444',name:'Thủng lốp giữa đường',cost:'80K - 250K',tip:'<strong>Xử lý nhanh:</strong> Không chạy tiếp khi lốp xẹp hẳn - hỏng vành và lốp. Dắt xe vào lề, bật xi-nhan cảnh báo và gọi vá lưu động.'},
  {icon:'fuel',bg:'rgba(59,130,246,.1)',color:'#3b82f6',name:'Hết xăng dọc đường',cost:'50K + tiền xăng',tip:'<strong>Xử lý nhanh:</strong> Cứu hộ mang xăng đến tận nơi trong bình chứa an toàn. Đủ để bạn chạy đến cây xăng gần nhất.'},
  {icon:'settings',bg:'rgba(235,47,150,.1)',color:'#EB2F96',name:'Chết máy không rõ nguyên nhân',cost:'150K - 500K',tip:'<strong>Xử lý nhanh:</strong> Không cố đạp/đề liên tục. Thợ kiểm tra tại chỗ bugi, xăng gió, IC - 70% ca sửa được ngay không cần kéo xe.'},
  {icon:'cloud-rain-wind',bg:'rgba(59,130,246,.1)',color:'#3b82f6',name:'Xe ngập nước / thủy kích',cost:'300K - 800K (kéo xe)',tip:'<strong>Quan trọng:</strong> TUYỆT ĐỐI không đề máy lại sau khi xe ngập - thủy kích phá động cơ, sửa 40-120 triệu. Gọi kéo xe về garage kiểm tra.'},
  {icon:'key-round',bg:'rgba(134,142,150,.12)',color:'#495057',name:'Mất chìa / khóa xe trong cốp',cost:'200K - 400K',tip:'<strong>Xử lý nhanh:</strong> Thợ khóa liên kết mở khóa không phá ổ, làm chìa tại chỗ. Cần mang giấy đăng ký xe để xác minh chính chủ.'},
];
const FAQS=[
  {q:'Cứu hộ có hoạt động ban đêm và ngày lễ không?',a:'Có. Mạng lưới cứu hộ hoạt động 24/7 kể cả lễ Tết. Ban đêm (22h-6h) phụ phí 30-50K tùy khu vực, hiển thị rõ trong báo giá trước khi bạn xác nhận.'},
  {q:'Chi phí được tính như thế nào, có bị "chặt chém" không?',a:'Mọi dịch vụ có giá niêm yết theo loại sự cố và quãng đường. Báo giá hiển thị trong App trước khi xác nhận - tài xế không được thu thêm ngoài báo giá. Nếu phát sinh, bạn xác nhận lại trong App mới được tính.'},
  {q:'Đang ở đường cao tốc / đường đèo có gọi được không?',a:'Được. Hệ thống định vị GPS hoạt động trên mọi tuyến đường. Với cao tốc, cứu hộ sẽ phối hợp đơn vị quản lý tuyến để tiếp cận an toàn - bạn chỉ cần đứng sau lan can chờ.'},
  {q:'Xe sửa không được tại chỗ thì sao?',a:'Cứu hộ kéo xe về garage liên kết gần nhất (hoặc garage bạn chỉ định). Phí kéo tính theo km, hiển thị trước. Bạn theo dõi được xe đang ở đâu trong suốt quá trình kéo.'},
  {q:'Có cần tài khoản MoMo mới gọi được cứu hộ không?',a:'Cần App MoMo để đặt lệnh và theo dõi tài xế. Thanh toán qua ví MoMo hoặc nguồn tiền liên kết - không cần tiền mặt, có hóa đơn điện tử lưu trong App.'},
];

document.getElementById('sit-grid').innerHTML=SITUATIONS.map(s=>`
  <div class="sit-card" onclick="toast('Mở MoMo App - sự cố \\'${s.name}\\' đã điền sẵn...')">
    <div class="sit-head">
      <div class="sit-icon" style="background:${s.bg};color:${s.color}"><i data-lucide="${s.icon}" width="19" height="19"></i></div>
      <div><div class="sit-name">${s.name}</div><div class="sit-cost">Chi phí tham khảo: <em>${s.cost}</em></div></div>
    </div>
    <div class="sit-tip">${s.tip}</div>
  </div>`).join('');

document.getElementById('faq-list').innerHTML=FAQS.map((f,i)=>`
  <div class="faq-item" id="faq-${i}">
    <button class="faq-q" onclick="toggleFaq(${i})">${f.q}<i data-lucide="chevron-down" width="16" height="16"></i></button>
    <div class="faq-a"><div class="faq-a-inner">${f.a}</div></div>
  </div>`).join('');

function toggleFaq(i){const el=document.getElementById('faq-'+i);const was=el.classList.contains('open');document.querySelectorAll('.faq-item.open').forEach(x=>x.classList.remove('open'));if(!was)el.classList.add('open');}

let toastTimer;
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2200);}

if(window.lucide)lucide.createIcons();
</script>

</VehicleHub>
