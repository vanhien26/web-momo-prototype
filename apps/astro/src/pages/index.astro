---
const pages = [
  {
    id: 'tien-ich-giao-thong',
    name: 'Tiện Ích Giao Thông',
    group: 'Platform',
    groupColor: '#3B82F6',
    maturity: 'Concept',
    description: 'Mini App quản lý phương tiện toàn diện: tra phạt nguội, nạp ePass, đăng kiểm, tìm cây xăng và quản lý xe trong một surface.',
    href: '/tien-ich-giao-thong',
    children: [
      { name: 'Bãi Đậu Xe', href: '/tien-ich-giao-thong/bai-do-xe' },
    ],
  },
];

const maturityColor: Record<string, string> = {
  Concept:     '#8B5CF6',
  Interactive: '#16A34A',
  Hub:         '#0284C7',
  Static:      '#9CA3AF',
};
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Prototype Lab — MoMo Astro</title>
  <link rel="icon" href="/images/momo-logo.svg" type="image/svg+xml">
  <style>
    @font-face {
      font-family: "MoMo Trust Sans";
      src: url("/fonts/momo-trust/MoMoTrustSans-Regular.otf") format("opentype");
      font-weight: 400; font-display: swap;
    }
    @font-face {
      font-family: "MoMo Trust Sans";
      src: url("/fonts/momo-trust/MoMoTrustSans-Medium.otf") format("opentype");
      font-weight: 500 900; font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100vh; }
    body {
      font-family: "MoMo Trust Sans", -apple-system, sans-serif;
      background: #F6F7F9;
      color: #1C171A;
    }
    a { text-decoration: none; color: inherit; }

    /* ── HEADER ── */
    .lab-header {
      background: #fff;
      border-bottom: 1px solid rgba(0,0,0,.07);
      box-shadow: 0 1px 3px rgba(0,0,0,.04);
      position: sticky; top: 0; z-index: 100;
    }
    .lab-header-inner {
      max-width: 1080px; margin: 0 auto;
      padding: 0 24px; height: 56px;
      display: flex; align-items: center; gap: 12px;
    }
    .lab-logo { display: flex; align-items: center; gap: 10px; }
    .lab-logo-icon {
      width: 30px; height: 30px; border-radius: 8px;
      overflow: hidden; flex-shrink: 0;
    }
    .lab-logo-icon img { width: 100%; height: 100%; display: block; }
    .lab-logo-name {
      font-size: 13.5px; font-weight: 800;
      color: #1C171A; letter-spacing: -.02em;
    }
    .lab-logo-name em { color: #EB2F96; font-style: normal; }
    .lab-header-sep { width: 1px; height: 18px; background: #E5E0E9; flex-shrink: 0; }
    .lab-header-tag {
      font-size: 12px; font-weight: 700;
      color: #7A6E7F; letter-spacing: .02em; text-transform: uppercase;
    }
    .lab-header-right {
      margin-left: auto;
      font-size: 12px; color: #A09AA5; font-weight: 500;
    }

    /* ── HERO ── */
    .lab-hero {
      max-width: 1080px; margin: 0 auto;
      padding: 48px 24px 32px;
    }
    .lab-hero-eyebrow {
      font-size: 11.5px; font-weight: 700; letter-spacing: .08em;
      text-transform: uppercase; color: #EB2F96; margin-bottom: 10px;
    }
    .lab-hero-title {
      font-size: 28px; font-weight: 800; letter-spacing: -.03em;
      color: #1C171A; margin: 0 0 10px; line-height: 1.2;
    }
    .lab-hero-desc {
      font-size: 14px; color: #5C5060; max-width: 520px; line-height: 1.6;
    }
    .lab-hero-meta {
      margin-top: 20px; display: flex; align-items: center; gap: 16px;
    }
    .lab-count {
      font-size: 12px; font-weight: 600; color: #7A6E7F;
    }
    .lab-count strong { color: #1C171A; }
    .lab-static-link {
      font-size: 12px; font-weight: 600; color: #EB2F96;
      display: inline-flex; align-items: center; gap: 4px;
      padding: 5px 10px; border-radius: 8px;
      background: #FFF0F8;
      transition: background .15s;
    }
    .lab-static-link:hover { background: #FFD6EE; }

    /* ── GRID ── */
    .lab-grid-wrap {
      max-width: 1080px; margin: 0 auto;
      padding: 0 24px 64px;
    }
    .lab-section-label {
      font-size: 11px; font-weight: 700; letter-spacing: .08em;
      text-transform: uppercase; color: #A09AA5;
      margin: 0 0 16px; padding-bottom: 8px;
      border-bottom: 1px solid #E5E0E9;
    }
    .lab-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
      margin-bottom: 40px;
    }
    .lab-card {
      background: #fff;
      border: 1px solid rgba(0,0,0,.07);
      border-radius: 16px;
      padding: 20px;
      display: flex; flex-direction: column; gap: 12px;
      transition: box-shadow .15s, border-color .15s, transform .15s;
      cursor: pointer;
      position: relative;
    }
    .lab-card:hover {
      box-shadow: 0 8px 24px rgba(28,23,26,.1);
      border-color: rgba(235,47,150,.2);
      transform: translateY(-2px);
    }
    .lab-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .lab-card-group {
      font-size: 10.5px; font-weight: 700; letter-spacing: .05em;
      text-transform: uppercase; padding: 3px 8px; border-radius: 6px;
      background: rgba(59,130,246,.1); color: #3B82F6;
    }
    .lab-card-maturity {
      font-size: 10.5px; font-weight: 600;
      padding: 3px 8px; border-radius: 6px;
      background: #F0EBF4; color: #7A6E7F;
    }
    .lab-card-name {
      font-size: 16px; font-weight: 800; letter-spacing: -.02em;
      color: #1C171A; margin: 0;
    }
    .lab-card-desc {
      font-size: 13px; color: #5C5060; line-height: 1.55;
      flex: 1;
    }
    .lab-card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 4px; }
    .lab-card-children {
      display: flex; gap: 6px; flex-wrap: wrap;
    }
    .lab-child-chip {
      font-size: 11px; font-weight: 600; color: #5C5060;
      padding: 3px 8px; border-radius: 6px;
      background: #F0EBF4;
      transition: background .12s, color .12s;
      white-space: nowrap;
    }
    .lab-child-chip:hover { background: #E5E0E9; color: #1C171A; }
    .lab-card-cta {
      font-size: 12px; font-weight: 700; color: #EB2F96;
      display: inline-flex; align-items: center; gap: 4px;
      flex-shrink: 0;
    }
    .lab-card-link {
      position: absolute; inset: 0; border-radius: 16px;
    }

    /* ── EMPTY STATE ── */
    .lab-empty {
      text-align: center; padding: 48px 24px;
      color: #A09AA5; font-size: 13px;
    }
    .lab-empty-icon { font-size: 32px; margin-bottom: 12px; }

    @media (max-width: 640px) {
      .lab-hero { padding: 32px 16px 24px; }
      .lab-hero-title { font-size: 22px; }
      .lab-grid-wrap { padding: 0 16px 48px; }
      .lab-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<header class="lab-header">
  <div class="lab-header-inner">
    <div class="lab-logo">
      <div class="lab-logo-icon">
        <img src="/images/momo-logo.svg" alt="MoMo">
      </div>
      <span class="lab-logo-name">Mo<em>Mo</em></span>
    </div>
    <div class="lab-header-sep"></div>
    <span class="lab-header-tag">Prototype Lab</span>
    <div class="lab-header-right">Astro · Next.js</div>
  </div>
</header>

<section class="lab-hero">
  <p class="lab-hero-eyebrow">Web Platform · Out-App Traffic</p>
  <h1 class="lab-hero-title">Prototype Lab</h1>
  <p class="lab-hero-desc">
    Các prototype đang được migrate sang Astro - chạy trên Next.js với routing thực, component reuse và design system chuẩn.
  </p>
  <div class="lab-hero-meta">
    <span class="lab-count"><strong>{pages.length}</strong> prototype</span>
    <a class="lab-static-link" href="http://localhost:3000/lab" target="_blank">
      Static Lab ↗
    </a>
  </div>
</section>

<div class="lab-grid-wrap">
  <p class="lab-section-label">Prototypes</p>
  <div class="lab-grid">
    {pages.map(p => (
      <article class="lab-card">
        <a class="lab-card-link" href={p.href} aria-label={p.name}></a>
        <div class="lab-card-top">
          <span class="lab-card-group" style={`background: ${p.groupColor}18; color: ${p.groupColor}`}>
            {p.group}
          </span>
          <span class="lab-card-maturity" style={`background: ${maturityColor[p.maturity]}15; color: ${maturityColor[p.maturity]}`}>
            {p.maturity}
          </span>
        </div>
        <h2 class="lab-card-name">{p.name}</h2>
        <p class="lab-card-desc">{p.description}</p>
        <div class="lab-card-footer">
          <div class="lab-card-children">
            {p.children?.map(c => (
              <a class="lab-child-chip" href={c.href} style="position: relative; z-index: 1;">{c.name}</a>
            ))}
          </div>
          <span class="lab-card-cta">Xem →</span>
        </div>
      </article>
    ))}
  </div>

  {pages.length === 0 && (
    <div class="lab-empty">
      <div class="lab-empty-icon">🧪</div>
      <p>Chưa có prototype nào.</p>
    </div>
  )}
</div>

</body>
</html>
