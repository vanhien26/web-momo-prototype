---
import { ClientRouter } from 'astro:transitions';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title: string;
  description?: string;
  theme?: 'momo' | 'parking' | 'energy' | 'official' | 'automotive';
  navProps?: Record<string, string>;
}

const {
  title,
  description = '',
  theme = 'momo',
  navProps = {},
} = Astro.props;
---

<!doctype html>
<html lang="vi" data-theme={theme}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title id="page-title">{title}</title>
  {description && <meta name="description" content={description}>}
  <link rel="icon" href="/images/momo-logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css">
  <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>
  <script src="/lucide.min.js" is:inline></script>
  <ClientRouter />


  <style is:global>
    /* ── FONT ── */
    @font-face {
      font-family: "MoMo Trust Sans";
      src: url("/fonts/momo-trust/MoMoTrustSans-Regular.otf") format("opentype");
      font-weight: 400; font-display: swap;
    }
    @font-face {
      font-family: "MoMo Trust Sans";
      src: url("/fonts/momo-trust/MoMoTrustSans-Medium.otf") format("opentype");
      font-weight: 500 900; font-display: swap;
    }

    /* ── RESET ── */
    *, *::before, *::after { box-sizing: border-box; }
    html, body { height: 100%; margin: 0; overflow: hidden; }
    body {
      color: var(--ink);
      background: var(--page);
      font-family: "MoMo Trust Sans", -apple-system, sans-serif;
      font-synthesis: none;
      display: flex;
      flex-direction: column;
    }
    a { color: inherit; text-decoration: none; }
    button, input, select { font: inherit; cursor: pointer; border: none; background: none; padding: 0; }

    /* ── GAS STRIP ── */
    .gas-strip { height: 36px; background: var(--gray-900); display: flex; align-items: center; justify-content: center; overflow: hidden; flex: none; }
    .gas-strip-inner { display: flex; align-items: center; gap: 20px; font-size: 11.5px; white-space: nowrap; }
    .gs-label { color: rgba(255,255,255,.45); display: flex; align-items: center; gap: 6px; font-weight: 700; }
    .gs-dot { width: 6px; height: 6px; border-radius: 50%; background: #16a34a; }
    .gs-item { display: flex; align-items: center; gap: 6px; color: rgba(255,255,255,.7); }
    .gs-name { font-weight: 600; }
    .gs-price { font-weight: 800; color: #fff; }
    .gs-change { font-size: 10px; font-weight: 700; } .gs-change.down { color: #f87171; }
    .gs-link { color: var(--pink-400); font-weight: 700; font-size: 11.5px; }

    /* ── SITE NAV ── */
    /* Force nav to always use light-mode colors, independent of data-theme */
    .site-nav {
      --nav-ink: #1c1c1e;
      --nav-muted: #6b7280;
      --nav-faint: #9ca3af;
      --nav-sep: #e5e7eb;
      --nav-hover-bg: rgba(0,0,0,.05);
      position: sticky; top: 0; z-index: 500; background: rgba(255,255,255,.97); backdrop-filter: blur(20px) saturate(180%); border-bottom: 1px solid rgba(0,0,0,.06); box-shadow: 0 1px 3px rgba(0,0,0,.04);
    }
    .nav-inner { max-width: 1080px; margin: 0 auto; height: 58px; padding: 0 20px; display: flex; align-items: center; gap: 0; overflow: visible; }
    .nav-left { display: flex; align-items: center; gap: 12px; flex-shrink: 0; margin-right: 8px; }
    .nav-back { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; color: var(--nav-faint); text-decoration: none; padding: 5px 8px; border-radius: 8px; transition: color .15s, background .15s; }
    .nav-back:hover { color: var(--nav-ink); background: var(--nav-hover-bg); }
    .nav-sep { width: 1px; height: 18px; background: var(--nav-sep); flex-shrink: 0; }
    .nav-logo { display: flex; align-items: center; gap: 9px; text-decoration: none; }
    .logo-icon { width: 32px; height: 32px; border-radius: 9px; overflow: hidden; flex-shrink: 0; }
    .logo-icon img { width: 100%; height: 100%; display: block; }
    .logo-text { font-size: 14px; font-weight: 800; color: var(--nav-ink); letter-spacing: -.02em; }
    .logo-text em { color: #eb2f96; font-style: normal; }

    /* nav items */
    .nav-links { display: flex; align-items: center; gap: 2px; flex: 1; }
    .nav-item { position: relative; }
    .nav-trigger { display: inline-flex; align-items: center; gap: 5px; height: 36px; padding: 0 12px; font-size: 13.5px; font-weight: 500; color: var(--nav-muted); background: none; border: none; cursor: pointer; white-space: nowrap; transition: color .15s, background .15s; font-family: inherit; border-radius: 10px; letter-spacing: -.01em; }
    .nav-trigger:hover, .nav-item:hover .nav-trigger { color: var(--nav-ink); background: var(--nav-hover-bg); }
    .nav-chevron { width: 13px; height: 13px; transition: transform .2s; flex: none; stroke: currentColor; stroke-width: 2; fill: none; }
    .nav-item:hover .nav-chevron { transform: rotate(180deg); }

    /* dropdown shell */
    .nav-dropdown {
      position: absolute; top: calc(100% + 8px); left: 50%;
      transform: translateX(-50%) translateY(-6px);
      background: #fff; border: 1px solid rgba(0,0,0,.08);
      border-radius: 16px; box-shadow: 0 16px 48px rgba(0,0,0,.12), 0 2px 8px rgba(0,0,0,.06);
      opacity: 0; pointer-events: none;
      transition: opacity .15s, transform .15s;
      z-index: 600; padding: 8px; min-width: 200px;
    }
    .nav-dropdown::before {
      content: ''; position: absolute; top: -8px; left: 0; right: 0; height: 8px;
    }
    .nav-dropdown-inner { display: contents; }
    .nav-item:hover .nav-dropdown { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0); }

    /* mega grid */
    .nav-mega { width: 560px; display: grid; grid-template-columns: 1fr 1fr; gap: 0; padding: 12px; }
    .mega-col { padding: 4px; }
    .mega-col-label { font-size: 10.5px; font-weight: 700; color: var(--nav-faint); letter-spacing: .06em; text-transform: uppercase; padding: 4px 8px 8px; border-bottom: 1px solid var(--nav-sep); margin-bottom: 4px; }
    .mega-item { display: flex; align-items: flex-start; gap: 10px; padding: 8px; border-radius: 10px; text-decoration: none; transition: background .12s; cursor: pointer; }
    .mega-item:hover { background: #f9fafb; }
    .mega-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .mega-icon svg, .mega-icon i { width: 15px; height: 15px; }
    .mega-item-name { font-size: 13px; font-weight: 600; color: var(--nav-ink); margin-bottom: 1px; line-height: 1.3; }
    .mega-item-desc { font-size: 11.5px; color: var(--nav-muted); line-height: 1.35; }

    /* simple list dropdown */
    .nav-list { min-width: 200px; padding: 4px; }
    .nav-list-item { display: flex; align-items: center; gap: 9px; padding: 8px 10px; border-radius: 9px; font-size: 13px; color: var(--nav-ink); font-weight: 500; transition: background .12s; cursor: pointer; white-space: nowrap; text-decoration: none; }
    .nav-list-item:hover { background: #f9fafb; }
    .nav-list-item i, .nav-list-item svg { width: 15px; height: 15px; flex-shrink: 0; color: var(--nav-faint); }
    .nav-list-sep { height: 1px; background: var(--nav-sep); margin: 4px 0; }

    @media (max-width: 768px) {
      .nav-inner { height: 48px; padding: 0 12px; }
      .nav-back span { display: none; }
      .nav-sep { display: none; }
      .logo-text { display: none; }
      .logo-icon { width: 28px; height: 28px; }
      .nav-links { overflow-x: auto; scrollbar-width: none; gap: 0; }
      .nav-links::-webkit-scrollbar { display: none; }
      .nav-trigger { height: 40px; padding: 0 10px; font-size: 12px; }
      .nav-dropdown { display: none; }
    }
  </style>
</head>
<body>
  <SiteNav {...navProps} />
  <slot />
</body>
</html>
